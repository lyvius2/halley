<!doctype html>
<html lang="ko">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Halley — 부동산 매물 비교</title>
	<link rel="stylesheet" href="/css/app.css">
	<script defer src="/js/app.js"></script>
	<script defer src="/js/vendor/alpine.min.js"></script>
</head>
<body x-data="halley()" x-init="init()">
	<div class="shell">
		<header class="app-header">
			<div class="brand-block">
				<p class="eyebrow">Halley</p>
				<h1>Property Map</h1>
			</div>
			<div class="header-actions">
				<div class="session-chip" x-text="session.authenticated ? session.nickname : '로그인 필요'"></div>
				<button class="ghost-button" x-show="session.role==='ADMIN'" @click="openUsers()">사용자</button>
				<button class="ghost-button danger" x-show="session.authenticated" @click="logout()">로그아웃</button>
			</div>
		</header>

		<main class="main-layer">
			<section class="map-panel">
				<div id="map" class="map-canvas"></div>
				<div class="map-empty" x-show="!session.authenticated || session.mustChangePassword">
					<strong>카카오맵 대기 중</strong>
					<span>로그인 후 매물 좌표가 마커로 표시됩니다.</span>
				</div>
			</section>

			<aside class="case-panel">
				<div class="panel-heading">
					<div>
						<p class="eyebrow">매물 큐</p>
						<h2>매물</h2>
					</div>
					<span class="count-badge" x-text="properties.length">0</span>
				</div>
				<div class="property-list">
					<template x-if="properties.length === 0">
						<div class="empty-card">아직 등록된 매물이 없습니다.</div>
					</template>
					<template x-for="p in properties" :key="p.id">
						<article class="property-card">
							<div class="property-card-header">
								<span class="property-card-name" x-text="p.name"></span>
								<span class="property-card-price" x-text="fmtWon(p.priceDeposit)"></span>
							</div>
							<div class="property-card-meta">
								<span class="badge" :class="dealBadge(p.dealType)" x-text="dealLabel(p.dealType)"></span>
								<span x-text="p.addressRoad"></span>
							</div>
						</article>
					</template>
				</div>
			</aside>
		</main>
	</div>

	<div class="modal-backdrop" x-show="showLogin" x-cloak>
		<section class="login-card">
			<div class="login-heading">
				<p class="login-brand">Halley.</p>
				<div class="login-heading-copy">
					<p class="eyebrow">Authentication Required</p>
					<p class="login-copy">로그인한 사용자만 이용할 수 있습니다.</p>
				</div>
			</div>
			<form class="login-form" @submit.prevent="login()">
				<label>
					<span>아이디</span>
					<input type="text" x-model="loginForm.email" autocomplete="username" placeholder="admin" required>
				</label>
				<label>
					<span>비밀번호</span>
					<input type="password" x-model="loginForm.password" autocomplete="current-password" required>
				</label>
				<button class="primary-button full" type="submit" :disabled="loading">
					<span x-text="loading ? '로그인 중…' : '로그인'"></span>
				</button>
				<p class="form-message" x-show="error" x-text="error"></p>
			</form>
		</section>
	</div>

	<div class="modal-backdrop" x-show="showPassword" x-cloak>
		<section class="login-card">
			<p class="eyebrow">Password Change Required</p>
			<p class="login-copy">초기/임시 비밀번호로 접속했습니다. 새 비밀번호를 설정해야 계속할 수 있습니다.</p>
			<form class="login-form" @submit.prevent="changePassword()">
				<label>
					<span>현재 비밀번호</span>
					<input type="password" x-model="passwordForm.currentPassword" autocomplete="current-password" required>
				</label>
				<label>
					<span>새 비밀번호</span>
					<input type="password" x-model="passwordForm.newPassword" autocomplete="new-password" minlength="8" required>
				</label>
				<button class="primary-button full" type="submit" :disabled="loading">
					<span x-text="loading ? '변경 중…' : '비밀번호 변경'"></span>
				</button>
				<p class="form-message" x-show="error" x-text="error"></p>
			</form>
		</section>
	</div>

	<div class="modal-backdrop" x-show="showUsers" x-cloak>
		<section class="route-card">
			<div class="modal-heading">
				<div>
					<p class="eyebrow">Account Management</p>
					<h2>사용자</h2>
				</div>
				<button class="icon-button" @click="showUsers = false">×</button>
			</div>
			<div class="member-list">
				<template x-for="u in users" :key="u.id">
					<div class="member-row">
						<div>
							<strong x-text="u.nickname"></strong>
							<span x-text="u.email"></span>
						</div>
						<span class="badge" :class="u.role==='ADMIN' ? 'b-sale' : 'b-jeonse'" x-text="u.role==='ADMIN' ? '관리자' : '회원'"></span>
						<span x-text="fmtWon(u.availableBudget)"></span>
					</div>
				</template>
				<template x-if="users.length === 0">
					<div class="empty-card">No users.</div>
				</template>
			</div>
		</section>
	</div>
</body>
</html>
