<!-- DRAFT 빠른 저장 모달 -->
<div class="modal" x-show="showDraftModal" x-cloak>
    <div class="modal-backdrop" @click="closeDraftModal()"></div>
    <div class="modal-card">
        <div class="modal-head">
            <span class="modal-kicker">빠른 저장</span>
            <h3>DRAFT 등록</h3>
            <p>네이버 매물 URL을 저장해 두고, 나중에 PC에서 붙여넣기로 완성합니다.</p>
        </div>
        <form class="form" @submit.prevent="saveDraft()">
            <label>원본 URL
                <input type="text" x-model="draftForm.sourceUrl" placeholder="https://fin.land.naver.com/articles/..." required>
            </label>
            <label>메모
                <input type="text" x-model="draftForm.memo" placeholder="마포역 근처 3호선">
            </label>
