<!-- D11 중개인 관리 모달 -->
<div class="modal" x-show="showAgentModal" x-cloak>
    <div class="modal-backdrop" @click="closeAgentModal()"></div>
    <div class="modal-card modal-wide">
        <div class="modal-head">
            <span class="modal-kicker">중개인</span>
            <h3 x-text="agentProperty?.property?.name"></h3>
            <p>이 매물을 담당하는 중개인을 연결합니다. 대표(1순위) 중개인은 1명입니다.</p>
        </div>
        <div class="card table-wrap">
            <table>
                <thead><tr><th>사무소</th><th>담당</th><th>연락처</th><th>대표</th><th></th></tr></thead>
                <tbody>
                <template x-if="agentLinks.length === 0">
                    <tr><td colspan="5" class="empty-cell">연결된 중개인이 없습니다</td></tr>
                </template>
                <template x-for="a in agentLinks" :key="a.agentId">
                    <tr>
                        <td class="strong" x-text="a.officeName || '-'"></td>
                        <td x-text="a.agentName || '-'"></td>
                        <td x-text="a.phone || a.mobile || '-'"></td>
                        <td><input type="radio" :checked="a.isPrimary" @change="setPrimaryAgent(a.agentId)"></td>
                        <td><button class="btn-link danger" @click="unlinkAgent(a.agentId)">해제</button></td>
                    </tr>
                </template>
                </tbody>
            </table>
        </div>

        <div class="form-grid" style="margin-top:14px;">
            <label class="span2">기존 중개인 검색
                <div class="workplace-search">
                    <input type="text" x-model="agentQuery" placeholder="사무소/담당명 검색" @keyup.enter="searchAgents()">
                    <button class="btn" @click="searchAgents()">검색</button>
                </div>
            </label>
            <template x-if="agentResults.length > 0">
                <div class="workplace-results span2">
                    <template x-for="r in agentResults" :key="r.id">
                        <button class="workplace-result" @click="addLinkedAgent(r.id)">
                            <span x-text="(r.officeName || '-') + ' · ' + (r.agentName || '-')"></span>
                            <small x-text="r.phone || r.mobile || ''"></small>
                        </button>
                    </template>
                </div>
            </template>
            <label>사무소명 <input type="text" x-model="newAgentForm.officeName"></label>
            <label>담당 <input type="text" x-model="newAgentForm.agentName"></label>
            <label>전화 <input type="text" x-model="newAgentForm.phone"></label>
            <label>휴대폰 <input type="text" x-model="newAgentForm.mobile"></label>
        </div>
        <p class="form-error" x-show="error" x-text="error"></p>
        <div class="paste-actions">
            <button class="btn" @click="createNewAgent()" :disabled="loading">새 중개인 등록 + 연결</button>
        </div>
    </div>
</div>

<!-- D12 사진 업로드 모달 -->
<div class="modal" x-show="showPhotoModal" x-cloak>
    <div class="modal-backdrop" @click="closePhotoModal()"></div>
    <div class="modal-card modal-wide">
        <button class="modal-close" @click="closePhotoModal()">×</button>
        <div class="modal-head">
            <span class="modal-kicker">이미지</span>
            <h3 x-text="photoProperty?.property?.name"></h3>
            <p>업로드 시 EXIF 방향을 보정하고 원본(최대 1920)·썸네일(320)로 저장합니다.</p>
        </div>

        <!-- 평면도: 매물당 한 장. 올리면 기존 것을 대체한다 (설계 I63) -->
        <section class="img-sec">
            <div class="img-sec-head">
                <h4>평면도</h4>
                <span class="img-sec-note">한 장만 둡니다. 새로 올리면 기존 평면도를 대체합니다.</span>
            </div>
            <template x-if="floorPlan">
                <div class="img-single">
                    <button class="photo-item" @click="openPhotoViewer(photoImages.indexOf(floorPlan))">
                        <img :src="floorPlan.storagePath" alt="평면도">
                    </button>
                    <button class="btn btn-xs btn-danger" @click="removeImage(floorPlan)" :disabled="loading">삭제</button>
                </div>
            </template>
            <label class="img-drop">
                <input type="file" accept="image/*" @change="uploadImages($event, 'FLOOR_PLAN')">
                <span x-text="floorPlan ? '평면도 교체하기' : '평면도 올리기'"></span>
            </label>
        </section>

        <!-- 매물사진: 여러 장 -->
        <section class="img-sec">
            <div class="img-sec-head">
                <h4>매물사진</h4>
                <span class="img-sec-note" x-text="photos.length + '장'"></span>
            </div>
            <div class="photo-grid" x-show="photos.length > 0">
                <template x-for="img in photos" :key="img.id">
                    <div class="photo-cell">
                        <button class="photo-item" @click="openPhotoViewer(photoImages.indexOf(img))">
                            <img :src="img.storagePath" alt="매물사진">
                        </button>
                        <button class="photo-del" @click="removeImage(img)" :disabled="loading" title="삭제">×</button>
                    </div>
                </template>
            </div>
            <p class="photo-empty" x-show="photos.length === 0">등록된 매물사진이 없습니다.</p>
            <label class="img-drop">
                <input type="file" accept="image/*" multiple @change="uploadImages($event, 'PHOTO')">
                <span>매물사진 올리기 (여러 장 선택 가능)</span>
            </label>
        </section>

        <p class="paste-hint" x-show="loading">업로드 중…</p>
        <p class="form-error" x-show="error" x-text="error"></p>
    </div>
</div>

<!-- D13 사진 뷰어 라이트박스 -->
<div class="lightbox" x-show="photoViewerIndex >= 0" x-cloak @click.self="closePhotoViewer()">
    <button class="lightbox-close" @click="closePhotoViewer()">×</button>
    <button class="lightbox-nav prev" @click="photoPrev()" x-show="photoViewerIndex > 0">‹</button>
    <img :src="photoViewerIndex >= 0 && photoImages[photoViewerIndex] ? photoImages[photoViewerIndex].storagePath : ''" alt="">
    <button class="lightbox-nav next" @click="photoNext()" x-show="photoViewerIndex < photoImages.length - 1">›</button>
</div>

