            <button class="btn btn-primary btn-block" type="submit" :disabled="loading">저장</button>
        </form>
    </div>
</div>

<!-- D9 붙여넣기 등록 모달 -->
<div class="modal" x-show="showPasteModal" x-cloak>
    <div class="modal-backdrop" @click="closePasteModal()"></div>
    <div class="modal-card modal-wide modal-tall">
        <div class="modal-head">
            <span class="modal-kicker">붙여넣기 등록</span>
            <h3 x-text="pastePreview ? '파싱 프리뷰' : (pasteDraftId ? 'DRAFT 완성하기' : '네이버 매물 상세 붙여넣기')"></h3>
            <p x-show="pasteDraftId">'<b x-text="pasteDraftName"></b>' 작성 중 매물을 텍스트로 완성합니다.</p>
            <p x-show="!pasteDraftId">네이버 부동산 매물 상세에서 전체 선택 → 복사 → 여기에 붙여넣으세요.</p>
        </div>
        <template x-if="!pastePreview">
            <div class="paste-step">
                <textarea id="pasteText" class="paste-textarea" x-model="pasteText"
                          @input="onPasteInput()" placeholder="매매&#10;매매가&#10;15억&#10;전용면적&#10;84.98㎡&#10;…"></textarea>
                <p class="paste-hint" x-show="pasteParsing">파싱 중…</p>
                <p class="form-error" x-show="pasteError && !pastePreview" x-text="pasteError"></p>
                <button class="btn btn-ghost" @click="closePasteModal()">닫기</button>
            </div>
        </template>
        <template x-if="pastePreview">
            <div class="paste-step">
                <p class="paste-warn" x-show="!pastePreview.isListing">네이버 매물 상세 텍스트가 아닌 것 같습니다. 직접 입력을 이용하세요.</p>
                <div class="paste-grid">
                    <template x-for="f in pastePreview.fields" :key="f.key">
                        <label class="paste-field" :class="'c-' + f.confidence">
                            <span class="paste-field-head">
                                <b x-text="fieldLabel(f.key)"></b>
                                <span class="badge" :class="f.confidence==='EXACT' ? 'b-on' : (f.confidence==='DERIVED' ? 'b-jeonse' : 'b-off')"
                                      x-text="confidenceLabel(f.confidence)"></span>
                            </span>
                            <input type="text" x-model="pasteForm[f.key]" :placeholder="f.confidence==='MISSING' ? '직접 입력' : ''">
                            <span class="paste-note" x-show="f.note" x-text="f.note"></span>
                        </label>
                    </template>
                </div>
                <p class="form-error" x-show="pasteError" x-text="pasteError"></p>
                <div class="paste-actions">
                    <button class="btn btn-ghost" @click="pastePreview=null; pasteForm={}">다시 입력</button>
                    <button class="btn btn-primary" @click="savePaste()" :disabled="pasteParsing">
                        <span x-text="pasteParsing ? '등록 중…' : '매물 등록'"></span>
                    </button>
                </div>
            </div>
        </template>
    </div>
</div>

<!-- D3 세션 만료 경고 모달 -->
<div class="modal" x-show="showSessionWarn" x-cloak>
