                <label>월세 (원)
                    <input type="number" min="0" x-model="propertyForm.priceMonthly" placeholder="0">
                </label>
                <label>관리비 (원/월)
                    <input type="number" min="0" x-model="propertyForm.maintenanceFee" placeholder="0">
