<!-- D2-2 프로필 확인 (강제 — 설계 6.1 · I48 · I100) -->
<div class="modal" x-show="showProfileSetup" x-cloak>
    <div class="modal-backdrop" @click="closeTopModal()"></div>
    <!-- 로그인·비밀번호 화면과 같은 결로 (설계 I121). 초기 설정 흐름은 하나로 읽혀야 한다 -->
    <div class="modal-card modal-wide modal-login">
        <div class="modal-head">
            <span class="modal-kicker">최초 설정</span>
            <h3>프로필을 확인해 주세요</h3>
            <!-- 관리자가 대신 넣은 값은 채워져 있을 뿐이다. 맞는지는 본인만 안다 (설계 I100) -->
            <p>관리자가 미리 넣어 둔 값이 있으면 아래에 채워져 있습니다.
                <b>맞으면 그대로 넘어가고, 다르면 여기서 고치세요.</b>
                직장 위치와 보유 현금은 <b>직주근접</b>·<b>가격</b> 채점에, 연소득은 <b>대출 한도</b>에 씁니다.</p>
        </div>
        <div class="form-grid">
            <label class="span2">닉네임
                <input type="text" x-model="setupForm.nickname" placeholder="리스트·코멘트에 표시되는 이름">
                <span class="settings-note">로그인 아이디와 별개인 표시 이름입니다. 매물을 등록하면 이 이름이 붙습니다.</span>
            </label>
            <label class="span2">직장 주소
                <div class="workplace-search">
                    <input type="text" x-model="setupForm.workplaceName" placeholder="주소 검색 버튼을 눌러 선택하세요" readonly>
                    <button class="btn" type="button" @click="searchPostcodeFor('setup')">주소 검색</button>
                </div>
            </label>
            <label>위도
                <input type="number" step="0.000001" x-model="setupForm.workplaceLat" readonly placeholder="주소 선택 시 자동 입력">
            </label>
            <label>경도
                <input type="number" step="0.000001" x-model="setupForm.workplaceLng" readonly placeholder="주소 선택 시 자동 입력">
            </label>
            <label class="span2">보유 현금 (총 자산에서 가용 가능한 금액 - 원)
                <span class="money-row">
                    <input type="text" inputmode="numeric" :value="setupForm.availableBudget" @input="setupForm.availableBudget = numericInput($event)" placeholder="300000000" style="width:50%">
                    <span class="money-hint" x-show="moneyHint(setupForm.availableBudget)"
                          x-text="moneyHint(setupForm.availableBudget)"></span>
                </span>
                <span class="settings-note">대출을 뺀 <b>동원 가능한 현금</b>입니다. 활성 사용자 전원의 합계가 가격 채점의 예산 상한이 됩니다.</span>
            </label>
            <label>연소득 (원)
                <span class="money-row">
                    <input type="text" inputmode="numeric" :value="setupForm.annualIncome" @input="setupForm.annualIncome = numericInput($event)" placeholder="50000000" style="width:50%">
                    <span class="money-hint" x-show="moneyHint(setupForm.annualIncome)"
                          x-text="moneyHint(setupForm.annualIncome)"></span>
                </span>
                <span class="settings-note">세전 기준. 대출 한도(DSR) 계산에 씁니다.</span>
            </label>
            <label>기존 대출액 (원)
                <span class="money-row">
                    <input type="text" inputmode="numeric" :value="setupForm.existingLoan" @input="setupForm.existingLoan = numericInput($event)" placeholder="0" style="width:50%">
                    <span class="money-hint" x-show="moneyHint(setupForm.existingLoan)"
                          x-text="moneyHint(setupForm.existingLoan)"></span>
                </span>
                <span class="settings-note">없으면 0으로 두세요.</span>
            </label>
        </div>
        <p class="form-error" x-show="error" x-text="error"></p>
        <button class="btn btn-primary btn-block" @click="saveProfileSetup()" :disabled="loading">
            <span x-text="loading ? '저장 중…' : '확인하고 시작하기'"></span>
        </button>
    </div>
</div>

<!-- D8 등록 방식 선택 모달 -->
<div class="modal" x-show="showAddMenu" x-cloak>
    <div class="modal-backdrop" @click="closeAddMenu()"></div>
    <div class="modal-card">
        <div class="modal-head">
            <span class="modal-kicker">매물 등록</span>
            <h3>등록 방식 선택</h3>
            <p>네이버 매물 상세 텍스트를 붙여넣거나 직접 입력하세요.</p>
        </div>
        <div class="add-choices">
            <button class="add-choice" @click="openPasteModal()">
                <b>붙여넣기로 등록</b>
                <span>네이버 매물 상세 텍스트를 복사해 붙여넣으면 자동 파싱됩니다.</span>
            </button>
            <button class="add-choice" @click="startManual()">
