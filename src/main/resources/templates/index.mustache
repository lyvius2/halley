                <label class="span2">주소로 좌표 검색
                    <div class="workplace-search">
                        <input type="text" x-model="propertyQuery" placeholder="예: 서울 노원구 상계동 692" @keyup.enter.prevent="searchPropertyAddress()">
                        <button class="btn" type="button" @click="searchPropertyAddress()">검색</button>
                    </div>
                </label>
                <template x-if="propertyAddrResults.length > 0">
                    <div class="workplace-results span2">
                        <template x-for="(r, i) in propertyAddrResults" :key="i">
                            <button class="workplace-result" type="button" @click="selectPropertyAddress(r)">
                                <span x-text="r.addressName"></span>
                                <small x-text="r.roadAddressName"></small>
                            </button>
                        </template>
                    </div>
                </template>
                <label class="span2">도로명주소
                    <input type="text" x-model="propertyForm.addressRoad" placeholder="서울시 ...">
                </label>
                <label>위도
                    <input type="number" step="0.000001" x-model="propertyForm.lat" placeholder="37.5">
                </label>
                <label>경도
                    <input type="number" step="0.000001" x-model="propertyForm.lng" placeholder="127.0">
                </label>
                <label>전용면적 (㎡)
                    <input type="number" step="0.01" min="0" x-model="propertyForm.areaExclusiveM2" placeholder="84.9">
                </label>
                <label>공급면적 (㎡)
                    <input type="number" step="0.01" min="0" x-model="propertyForm.areaSupplyM2" placeholder="112.0">
                </label>
                <label>층
                    <input type="number" min="1" x-model="propertyForm.floorNo" placeholder="5">
                </label>
                <label>총 층수
                    <input type="number" min="1" x-model="propertyForm.floorTotal" placeholder="12">
                </label>
                <label>향
                    <input type="text" x-model="propertyForm.direction" placeholder="남향">
                </label>
                <label>준공년도
                    <input type="number" min="1900" x-model="propertyForm.approvalYear" placeholder="2018">
                </label>
                <label>건물동수
                    <input type="number" min="1" x-model="propertyForm.buildingCount" placeholder="3">
                </label>
                <label>총세대수
                    <input type="number" min="1" x-model="propertyForm.totalHouseholds" placeholder="300">
                </label>
                <label>입주가능
                    <select x-model="propertyForm.moveInType">
                        <option value="">선택 안 함</option>
                        <option value="IMMEDIATE">즉시 입주</option>
                        <option value="NEGOTIABLE">협의</option>
                        <option value="DATE">날짜 지정</option>
                    </select>
                </label>
                <label>입주가능일
                    <input type="date" x-model="propertyForm.moveInDate">
                </label>
            </div>
            <p class="form-error" x-show="error" x-text="error"></p>
            <button class="btn btn-primary btn-block" type="submit" :disabled="loading">
                <span x-text="loading ? '저장 중…' : (propertyForm.id ? '저장' : '등록')"></span>
            </button>
        </form>
    </div>
</div>

<!-- D14 평가 채점 모달 -->
<div class="modal" x-show="showScoreModal" x-cloak>
    <div class="modal-backdrop" @click="closeScoreModal()"></div>
    <div class="modal-card modal-wide">
        <div class="modal-head">
            <span class="modal-kicker">평가 채점</span>
            <h3 x-text="scoreProperty?.property?.name"></h3>
            <p>항목별 수동 점수를 입력하면 자동 점수를 덮어씁니다. 쾌적함은 사용자별 1~5로 평가합니다.</p>
        </div>
        <div class="score-list">
            <template x-for="s in (scoreProperty?.scores || [])" :key="s.code">
                <label class="score-row">
                    <span class="score-name">
                        <b x-text="s.name"></b>
                        <span class="score-source" x-text="scoreSourceLabel(s.scoreSource)"></span>
                        <span class="score-source" x-show="s.scoringType==='HYBRID'">추정</span>
                    </span>
                    <button class="btn-link" x-show="s.scoringType==='HYBRID'" @click="confirmHybridScore(s.code)">추정값 확정</button>
                    <span class="score-auto" x-text="'유효 ' + fmtScore(s.effectiveScore)"></span>
                    <input type="number" x-model="scoreForm[s.code]"
                           :min="s.code === 'COMFORT' ? 1 : 0"
                           :max="s.code === 'COMFORT' ? 5 : 100"
                           :placeholder="s.code === 'COMFORT' ? '1~5' : '0~100'">
                </label>
            </template>
        </div>
        <p class="form-error" x-show="error" x-text="error"></p>
        <button class="btn btn-primary btn-block" @click="saveScore()" :disabled="loading">
            <span x-text="loading ? '저장 중…' : '채점 저장'"></span>
        </button>
    </div>
</div>

<!-- D16-2 국토부 실거래가 참고 카드 모달 -->
<div class="modal" x-show="showRefModal" x-cloak>
    <div class="modal-backdrop" @click="closeRefModal()"></div>
    <div class="modal-card modal-wide">
        <div class="modal-head">
            <span class="modal-kicker">최근 실거래</span>
            <h3 x-text="refProperty?.property?.name"></h3>
            <p>국토부 실거래가 참고용입니다. 채점에는 반영되지 않습니다.</p>
        </div>
        <div class="form-grid">
            <label>법정동코드 (5자리)
                <input type="text" x-model="refForm.legalDongCode" placeholder="11010" maxlength="5">
            </label>
            <label>계약년월 (YYYYMM)
                <input type="text" x-model="refForm.dealMonth" placeholder="202607" maxlength="6">
            </label>
        </div>
        <div class="paste-actions">
            <button class="btn btn-primary" @click="loadReference()" :disabled="loading">조회</button>
        </div>
        <p class="form-error" x-show="error" x-text="error"></p>
        <template x-if="refCard">
            <div class="ref-card">
                <template x-if="refCard.transactions.length === 0">
                    <p class="ref-empty">실거래 내역이 없습니다. 법정동코드·계약년월을 확인하세요.</p>
                </template>
                <template x-for="t in refCard.transactions" :key="t.contractDate + '-' + t.floorNo">
                    <div class="ref-row">
                        <span x-text="t.contractDate"></span>
                        <b x-text="fmtWon(t.price)"></b>
                        <span x-text="t.floorNo ? t.floorNo + '층' : ''"></span>
                    </div>
                </template>
                <p class="ref-gap" x-show="refCard.gapPercent != null">
                    호가 <b x-text="fmtWon(refCard.askingPrice)"></b> vs 최근 실거래 → 괴리 <b x-text="(refCard.gapPercent > 0 ? '+' : '') + refCard.gapPercent + '%'"></b>
                </p>
            </div>
        </template>
    </div>
</div>

<!-- D16 대출 한도 시뮬레이션 모달 -->
<div class="modal" x-show="showLoanModal" x-cloak>
    <div class="modal-backdrop" @click="closeLoanModal()"></div>
    <div class="modal-card modal-wide">
        <div class="modal-head">
            <span class="modal-kicker">대출 한도</span>
            <h3 x-text="loanProperty?.property?.name"></h3>
            <p>LTV·DSR 기반 자체 계산입니다. 실제 한도는 은행 가심사가 필요합니다.</p>
        </div>
        <form class="form" @submit.prevent="runLoanEstimate()">
            <div class="form-grid">
                <label>연 소득 (원)
                    <input type="number" min="0" x-model="loanForm.annualIncome" placeholder="50000000" required>
                </label>
                <label>보유 현금 (원)
                    <input type="number" min="0" x-model="loanForm.cash" placeholder="300000000" required>
                </label>
                <label class="span2">생애최초
                    <input type="checkbox" x-model="loanForm.firstHome">
                </label>
            </div>
            <p class="form-error" x-show="error" x-text="error"></p>
            <button class="btn btn-primary btn-block" type="submit" :disabled="loading">
                <span x-text="loading ? '계산 중…' : '한도 계산'"></span>
            </button>
        </form>
        <template x-if="loanResult">
            <div class="loan-result">
                <div class="loan-row"><span>LTV 한도</span><b x-text="fmtWon(loanResult.ltvLimit)"></b></div>
                <div class="loan-row"><span>DSR 한도</span><b x-text="fmtWon(loanResult.dsrLimit)"></b></div>
                <div class="loan-row"><span>최종 한도</span><b x-text="fmtWon(loanResult.finalLimit)"></b></div>
                <div class="loan-row"><span>필요 현금</span><b x-text="fmtWon(loanResult.requiredCash)"></b></div>
                <div class="loan-row"><span>취득세</span><b x-text="fmtWon(loanResult.acquisitionTax)"></b></div>
                <div class="loan-row"><span>월 상환액</span><b x-text="fmtWon(loanResult.monthlyPayment)"></b></div>
                <p class="loan-note">월 상환액은 LTV·DSR 한도 기준 추정치입니다. 은행 가심사를 받으세요.</p>
            </div>
        </template>
    </div>
</div>

<!-- D20 매물 점검 이력 모달 -->
<div class="modal" x-show="showCheckLogs" x-cloak>
    <div class="modal-backdrop" @click="closeCheckLogs()"></div>
    <div class="modal-card modal-wide">
        <div class="modal-head">
            <span class="modal-kicker">점검 이력</span>
            <h3 x-text="checkLogProperty?.property?.name"></h3>
            <p>생존 확인 배치의 판정 기록입니다.</p>
        </div>
        <div class="card table-wrap">
            <table>
                <thead><tr><th>시각</th><th>판정</th><th>HTTP</th><th>근거</th></tr></thead>
                <tbody>
                <template x-if="checkLogs.length === 0">
                    <tr><td colspan="4" class="empty-cell">점검 이력이 없습니다</td></tr>
                </template>
                <template x-for="l in checkLogs" :key="l.id">
                    <tr>
                        <td x-text="fmtTime(l.checkedAt)"></td>
                        <td><span class="badge" :class="l.verdict==='ALIVE' ? 'b-on' : 'b-off'" x-text="verdictLabel(l.verdict)"></span></td>
                        <td class="num" x-text="l.httpStatus ?? '-'"></td>
                        <td x-text="l.evidence"></td>
                    </tr>
                </template>
                </tbody>
            </table>
        </div>
        <div class="paste-actions">
            <button class="btn btn-ghost" @click="closeCheckLogs()">닫기</button>
            <button class="btn btn-primary" x-show="checkLogProperty?.property?.listingStatus==='SOLD_OUT'"
                    @click="restoreListing(checkLogProperty)">판매중으로 복구</button>
        </div>
    </div>
</div>

<!-- D21 판매완료 알림 확인 모달 -->
<div class="modal" x-show="showSoldOutAlert" x-cloak>
    <div class="modal-backdrop" @click="closeSoldOutAlert()"></div>
    <div class="modal-card">
        <div class="modal-head">
            <span class="modal-kicker">알림</span>
            <h3>판매완료 감지 매물</h3>
            <p>생존 확인 배치에서 판매완료로 판정된 매물입니다.</p>
        </div>
        <div class="property-list">
            <template x-for="p in soldOutRecent" :key="p.id">
                <article class="property-card sold">
                    <div class="property-card-header">
                        <span class="property-card-name" x-text="p.name"></span>
                        <span class="property-card-price" x-text="fmtWon(p.priceDeposit)"></span>
                    </div>
                    <div class="property-card-meta">
                        <span class="badge b-off">판매완료</span>
                        <span x-text="p.soldDetectedAt ? '감지 ' + fmtTime(p.soldDetectedAt) : ''"></span>
                    </div>
                </article>
            </template>
        </div>
        <div class="paste-actions">
            <button class="btn btn-primary" @click="closeSoldOutAlert()">확인</button>
        </div>
    </div>
</div>

<!-- D23 로드뷰 모달 -->
<div class="modal modal-roadview" x-show="showRoadview" x-cloak>
    <div id="roadview" class="rv-canvas"></div>
    <div class="rv-fallback" x-show="roadviewState === 'missing'">
        <div class="empty-ic">◌</div>
        <h4>이 위치는 로드뷰가 제공되지 않습니다</h4>
        <p>신축 단지나 골목 안쪽은 로드뷰가 없을 수 있습니다.</p>
    </div>
    <div class="rv-top" x-show="roadviewProperty">
        <div class="rv-info">
            <span class="rv-name" x-text="roadviewProperty?.name"></span>
            <span class="rv-meta">
                <span class="badge" :class="roadviewProperty ? dealBadge(roadviewProperty.dealType) : ''" x-text="roadviewProperty ? dealLabel(roadviewProperty.dealType) : ''"></span>
                <span x-text="roadviewProperty ? fmtWon(roadviewProperty.priceDeposit) : ''"></span>
            </span>
        </div>
        <button class="btn btn-ghost" @click="closeRoadview()">닫기</button>
    </div>
</div>

</body>
</html>
