<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Halley — 부동산 매물 비교</title>
    <!-- 파비콘 (설계 I174). 32px 는 탭, 180px 는 iOS 홈 화면 -->
    <link rel="icon" type="image/png" sizes="32x32" href="/image/favicon-32.png">
    <link rel="apple-touch-icon" href="/image/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@300;500;700&family=Noto+Sans+KR:wght@300;400;500;700&family=Noto+Sans:wght@400;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/app.css?v={{assetVersion}}">
    <script defer src="/js/app.js?v={{assetVersion}}"></script>
    <script defer src="/js/vendor/alpine.min.js"></script>
    <!-- 카카오(다음) 우편번호 서비스 — 주소 검색 팝업 -->
    <script src="https://t1.daumcdn.net/mapjsapi/bundle/postcode/prod/postcode.v2.js"></script>
    {{#kakaoJsKey}}
    <script src="https://dapi.kakao.com/v2/maps/sdk.js?appkey={{kakaoJsKey}}&autoload=false"></script>
    {{/kakaoJsKey}}
</head>
<!-- 주소는 x-effect 가 맞춘다 (설계 I211). $watch 로 플래그를 열거하려 했으나
     Alpine 안에서 Object.keys(this) 가 빈 배열이라 <b>하나도 안 걸렸다</b> -->
<body x-data="halley()" x-init="init()" x-effect="syncRoute()"
      @keydown.escape.window="closeTopModal()"
      @keydown.arrow-left.window="onViewerKey(-1)" @keydown.arrow-right.window="onViewerKey(1)">

<div class="shell">
    <div class="topbar">
        <div class="topbar-in">
            <a class="wordmark" href="/">
                <!-- 64px 원본을 24px 로 줄여 쓴다 — 고해상도 화면에서 흐려지지 않는다.
                     원본(1254px · 940KB)을 그대로 걸면 헤더 하나에 1MB 를 쓴다 (설계 I174) -->
                <img class="wordmark-logo" src="/image/logo-64.png" alt="" width="24" height="24">
                <span>Halley</span>
            </a>
            <template x-if="session.authenticated">
                <nav class="nav">
                    <button class="nav-btn" :class="{on: view==='list'}" @click="setView('list')">매물</button>
                    <button class="nav-btn" :class="{on: view==='itinerary'}" @click="setView('itinerary')">임장</button>
                    <button class="nav-btn" :class="{on: view==='weights'}" x-show="session.role==='ADMIN'" @click="setView('weights')">기준</button>
                    <button class="nav-btn" :class="{on: showUsers}" x-show="session.role==='ADMIN'" @click="openUsers()">사용자</button>
                    <button class="nav-btn" :class="{on: showSettings}" x-show="session.role==='ADMIN'" @click="openSettings()">설정</button>
                    <!-- 「{그룹명}의 {닉네임}」 (설계 I170).
                         한 문장으로 읽히지만 <b>가는 곳이 둘</b>이라 버튼도 둘이다 —
                         앞은 그룹 정보(I123), 뒤는 내 프로필(I153). 사이의 구분선만 지운다 -->
                    <button class="nav-btn nav-mine" type="button" x-show="myGroup"
                            :class="{on: view==='group'}" @click="setView('group')"
                            :title="'그룹 정보 · ' + (myGroup ? myGroup.name : '')">
                        <span x-text="(myGroup ? myGroup.name : '') + '의'"></span>
                    </button>
                    <button class="nav-btn nav-mine nav-mine-tail" type="button"
                            :class="{on: view==='me'}" @click="setView('me')" title="내 프로필">
                        <!-- 닉네임이 이미 '관리자'면 ' · 관리자'를 붙이지 않는다 (설계 I186).
                             기본 관리자 계정의 닉네임이 그것이라 '관리자 · 관리자'가 됐다 -->
                        <span x-text="session.nickname"></span><span
                                x-text="session.role==='ADMIN' && session.nickname !== '관리자'
                                        ? ' · 관리자' : ''"></span>
                    </button>
                    <button class="btn btn-ghost" @click="logout()">로그아웃</button>
                </nav>
            </template>
        </div>
    </div>

    <main class="main-grid" :class="mobileTab">
        <div class="mobile-tabs">
            <button :class="{on: mobileTab==='map'}" @click="setMobileTab('map')">지도</button>
            <button :class="{on: mobileTab==='list'}" @click="setMobileTab('list')">리스트</button>
        </div>
        <section class="map-panel">
            <div id="map" class="map-canvas"></div>
            <div class="map-empty" x-show="!session.authenticated || session.mustChangePassword">
                <div class="empty-ic">◌</div>
                <h4>카카오맵 대기 중</h4>
                <p>로그인 후 매물 좌표가 마커로 표시됩니다.</p>
            </div>
        </section>

        <aside class="list-panel">
            <template x-if="session.authenticated && !session.mustChangePassword">
                <div>
                    <div x-show="view==='list'">
                        <div class="sec-head sec-head-actions">
                            <h2>매물</h2>
                            <!-- 몇 건 중 몇 건을 보고 있는지 (설계 I240). 30건씩 받으므로
                                 그냥 '30건'이라고 하면 <b>정말 30건인 줄</b> 안다 -->
                            <span class="sec-sub"
                                  x-text="propertyTotal > properties.length
                                      ? properties.length + ' / ' + propertyTotal + '건'
                                      : propertyTotal + '건'"></span>
                            <div class="sec-actions">
                                <button class="btn btn-sm" @click="openCompare()"
                                        :disabled="!canCompare()" :title="compareHint()">비교 우위 분석</button>
                                <button class="btn btn-primary btn-sm" @click="openAddMenu()">+ 매물 추가</button>
                            </div>
                        </div>
                        <div class="deal-tabs">
                            <button :class="{on: dealTypeFilter==='ALL'}" @click="setDealTypeFilter('ALL')">전체</button>
                            <button :class="{on: dealTypeFilter==='SALE'}" @click="setDealTypeFilter('SALE')">매매</button>
                            <button :class="{on: dealTypeFilter==='JEONSE'}" @click="setDealTypeFilter('JEONSE')">전세</button>
                            <!-- 치워 둔 매물 (설계 I241). 뱃지가 없으면 <b>치웠다는 사실 자체를
                                 잊습니다</b> — 0건이면 뱃지를 안 답니다 -->
                            <button class="tab-archive" :class="{on: dealTypeFilter==='ARCHIVE'}"
                                    @click="setDealTypeFilter('ARCHIVE')">
                                아카이빙
                                <span class="tab-badge" x-show="archivedTotal > 0" x-cloak
                                      x-text="archivedTotal"></span>
                            </button>
                            <!-- 판매완료 숨김을 없앴다 (설계 I221). 생존 확인 배치를
                                 걷어낸 뒤(I157) 그 값을 갱신하는 것이 아무것도 없다 -->
                            <div class="sort-picker" @click.outside="sortOpen = false">
                                <button class="sort-trigger" @click="sortOpen = !sortOpen">
                                    <span x-text="sortLabel()"></span>
                                    <i class="sort-caret" :class="{open: sortOpen}">▾</i>
                                </button>
                                <div class="sort-menu" x-show="sortOpen" x-cloak>
                                    <template x-for="s in SORTS" :key="s.key">
                                        <button :class="{on: sortKey === s.key}" @click="setSort(s.key)"
                                                x-text="s.label"></button>
                                    </template>
                                </div>
                            </div>
                        </div>
                        <div class="property-list">
                            <!-- 목록이 오기 전에는 '없습니다'가 아니라 기다리는 중임을 말한다 (설계 I122) -->
                            <div class="progress-strip" x-show="isLoading('properties')" x-cloak>
                                <span class="progress-strip-label">데이터 로딩 중입니다…</span>
                                <div class="progress-strip-bar"><i></i></div>
                            </div>
                            <template x-if="properties.length === 0 && !isLoading('properties')">
                                <div class="empty">
                                    <div class="empty-ic">◌</div>
                                    <h4>아직 등록된 매물이 없습니다</h4>
                                    <p>네이버 매물 상세 텍스트를 붙여넣거나 직접 입력해 첫 매물을 등록해 보세요.</p>
                                    <button class="btn btn-primary" @click="openAddMenu()">+ 매물 추가</button>
                                </div>
                            </template>
                            <template x-for="r in properties" :key="r.property.id">
                                <article class="property-card" :class="{active: activePropertyId === r.property.id, sold: r.property.listingStatus==='SOLD_OUT'}"
                                         :id="'prop-' + r.property.id" @click="focusProperty(r)">
                                    <div class="property-card-header">
                                        <!-- 같은 단지 매물이 여럿이면 <b>동·호가 유일한 구분</b>이다 (설계 I265).
                                             없으면 카드가 전부 같은 이름으로 보인다 -->
                                        <span class="property-card-name" x-text="propertyTitle(r.property)"></span>
                                        <!-- 가격 전망 (설계 I136). 화살표는 오직 LLM 예측만 나타낸다 —
                                             코드 예측과 갈려도 색을 흐리지 않는다. 그 사실은 모달에서 말한다 -->
                                        <button class="forecast-arrow" type="button"
                                                x-show="forecastArrow(r)"
                                                :class="forecastArrowClass(r)"
                                                :title="forecastTitle(r)"
                                                @click.stop="openForecast(r)"
                                                x-text="forecastArrow(r)"></button>
                                        <span class="owner-badge" x-show="r.property.createdByNickname"
                                              :title="'등록: ' + r.property.createdByNickname">
                                            <i class="owner-initial" x-text="ownerInitial(r.property.createdByNickname)"></i>
                                            <span x-text="r.property.createdByNickname"></span>
                                        </span>
                                        <!-- 그룹 badge는 admin에게만 온다 (설계 I87 · 규칙 5) -->
                                        <span class="group-badge" x-show="r.property.groupName"
                                              :title="'그룹: ' + r.property.groupName"
                                              x-text="r.property.groupName"></span>
                                        <!-- 쾌적함이 채점됐다면 누군가 다녀온 것이다 (설계 I121) -->
                                        <span class="badge b-visited" x-show="hasVisited(r)"
                                              :class="{mine: scoredComfort(r)}"
                                              :title="visitedTitle(r)">🚩 임장완료</span>
                                        <!-- 전망이 없는 매물은 매매가를 눌러 분석시킨다 (설계 I142).
                                             이미 낸 적이 있으면 누를 수 없다 — UNCERTAIN 이라도 그건 답이다 -->
                                        <span class="property-card-price"
                                              :class="{'price-triggerable': canTriggerForecast(r)}"
                                              :title="forecastPriceTitle(r)"
                                              @click.stop="triggerForecast(r)"
                                              x-text="fmtWon(r.property.priceDeposit)"></span>
                                    </div>
                                    <div class="property-card-meta">
                                        <span class="badge" :class="dealBadge(r.property.dealType)" x-text="dealLabel(r.property.dealType)"></span>
                                        <span class="badge b-admin" x-show="r.property.isDraft">작성 중</span>
                                        <span class="badge b-off" x-show="r.property.listingStatus==='SOLD_OUT'">판매완료</span>
                                        <span x-text="r.property.addressRoad"></span>
                                        <span x-show="floorLabel(r.property)" x-text="floorLabel(r.property)"></span>
                                        <span x-show="r.property.areaSupplyM2" x-text="'공급 ' + fmtArea(r.property.areaSupplyM2)"></span>
                                        <span x-show="r.property.areaExclusiveM2" x-text="'전용 ' + fmtArea(r.property.areaExclusiveM2)"></span>
                                        <!-- 등록 직후에는 점수가 없다 (설계 I220). 배경에서
                                             채워지는 중임을 말해 준다 — 몇 초 뒤 저절로 바뀐다 -->
                                        <span class="score-pill is-pending" x-show="scoring(r)">
                                            <i class="dot-spin"></i><i>분석 중</i>
                                        </span>
                                        <!-- 못 잰 것을 <b>나쁜 점수처럼</b> 칠하지 않는다 (설계 I284).
                                             점수가 없으면 붉은 score-low 가 아니라 무채색이다 -->
                                        <span class="score-pill" x-show="!scoring(r)"
                                              :class="r.totalScore == null ? 'is-unscored'
                                                      : (r.totalScore >= 50 ? 'score-high' : 'score-low')">
                                            <b x-text="fmtScore(r.totalScore)"></b><i>점</i>
                                        </span>
                                    </div>
                                    <div class="property-card-actions" @click.stop>
                                        <button class="btn-link" @click="openDetail(r)">상세</button>
                                        <button class="btn-link" x-show="r.property.isDraft" @click="openPasteModal(r)">완성</button>
                                        <button class="btn-link" @click="openComments(r)">코멘트</button>
                                        <button class="btn-link" @click="openScoreModal(r)">채점</button>
                                        <button class="btn-link" @click="openLoanModal(r)">대출</button>
                                        <button class="btn-link" @click="openRefModal(r)">실거래</button>
                                        <button class="btn-link" @click="openEditProperty(r)">수정</button>
                                        <!-- 치우기는 수정 옆에 (설계 I241). 되돌릴 수 있는 일이라
                                             삭제와 나란히 두면 잘못 누르기 쉽다 -->
                                        <button class="btn-link" x-show="!archiveTab"
                                                @click="archiveProperty(r)">아카이브</button>
                                        <button class="btn-link" x-show="archiveTab" x-cloak
                                                @click="unarchiveProperty(r)">복구</button>
                                        <!-- 삭제만 맨 오른쪽으로 떨어뜨린다 — 되돌릴 수 없는 것은
                                             손이 미끄러지는 자리에 두지 않는다 -->
                                        <button class="btn-link danger act-last"
                                                @click="removeProperty(r)">삭제</button>
                                    </div>
                                </article>
                            </template>
                            <!-- 무한 스크롤의 감시점 (설계 I240).
                                 늘 자리에 둡니다 — 숨기면(display:none) 관찰이 안 걸려
                                 <b>다음 쪽을 영영 안 부릅니다.</b> -->
                            <div id="list-sentinel" class="list-sentinel">
                                <span x-show="loadingMore" x-cloak>더 불러오는 중…</span>
                                <span x-show="!loadingMore &amp;&amp; !propertyHasNext &amp;&amp; propertyTotal > PAGE_SIZE"
                                      x-cloak>모두 불러왔습니다</span>
                            </div>
                        </div>
                    </div>

                    <div x-show="view==='weights'">
                        <div class="sec-head"><h2>평가 기준·가중치</h2><span class="sec-sub" x-text="weights.length + '개'"></span></div>
                        <div class="card table-wrap">
                            <table>
                                <thead>
                                <tr><th>순위</th><th>기준</th><th>유형</th><th>가중치</th><th>이동</th></tr>
                                </thead>
                                <tbody>
                                <template x-for="(w, i) in weights" :key="w.criterionCode">
                                    <tr draggable="true" @dragstart="dragStartWeight(i)" @dragover.prevent="dragOverWeight(i)"
                                        @dragend="dragEndWeight()" :class="{dragging: _dragIndex === i}">
                                        <td class="num drag-handle" x-text="i + 1"></td>
                                        <td class="strong" x-text="w.name"></td>
                                        <td>
                                            <span class="badge" :class="w.scoringType==='AUTO' ? 'b-mem' : (w.scoringType==='HYBRID' ? 'b-jeonse' : 'b-admin')"
                                                  x-text="w.scoringType==='AUTO' ? '자동' : (w.scoringType==='HYBRID' ? '추정' : '수동')"></span>
                                        </td>
                                        <td class="num" x-text="w.weight"></td>
                                        <td>
                                            <button class="btn-link" @click="moveWeight(i, -1)" :disabled="i === 0">↑</button>
                                            <button class="btn-link" @click="moveWeight(i, 1)" :disabled="i === weights.length - 1">↓</button>
                                        </td>
                                    </tr>
                                </template>
                                </tbody>
                            </table>
                        </div>
                        <p class="form-error" x-show="error" x-text="error"></p>
                        <button class="btn btn-primary" @click="saveWeights()" :disabled="loading">
                            <span x-text="loading ? '저장 중…' : '가중치 저장'"></span>
                        </button>
                    </div>

                    <div x-show="view==='itinerary'">
                        <div class="sec-head"><h2>임장 플래너</h2><span class="sec-sub" x-text="itinProperties.length + '건 선택'"></span></div>
                        <div class="card itin-panel">
                            <div class="form-grid">
                                <label class="span2">출발지 주소
                                    <div class="workplace-search">
                                        <input type="text" x-model="itinStart.address" placeholder="주소 검색 버튼을 눌러 선택하세요" readonly>
                                        <button class="btn" type="button" @click="searchPostcodeFor('itinerary')">주소 검색</button>
                                    </div>
                                </label>
                                <label>위도
                                    <input type="number" step="0.000001" x-model="itinStart.lat" readonly placeholder="주소 선택 시 자동 입력">
                                </label>
                                <label>경도
                                    <input type="number" step="0.000001" x-model="itinStart.lng" readonly placeholder="주소 선택 시 자동 입력">
                                </label>
                                <label>이동수단
                                    <select x-model="itinMode">
                                        <option value="DRIVING">자가용</option>
                                        <option value="TRANSIT">대중교통</option>
                                    </select>
                                </label>
                                <!-- 지나간 시각으로는 못 짠다 (설계 I207) -->
                                <label>임장 날짜
                                    <input type="date" x-model="itinDate" :min="todayIso()"
                                           @change="normalizeItinStart()">
                                </label>
                                <label>시작시간
                                    <input type="time" x-model="itinWindowStart" :min="minItinTime()">
                                </label>
                                <label>체류(분)
                                    <input type="number" min="5" x-model="itinStay">
                                </label>
                            </div>
                            <!-- 목록은 30건씩 잘려 오지만 임장 대상은 <b>전부</b> 고를 수
                                 있어야 한다 (설계 I240) — 얇은 전체 목록을 쓴다 -->
                            <div class="itin-props">
                                <template x-for="p in pins" :key="p.id">
                                    <!-- 이미 다녀온 곳은 흐리게 (설계 I225).
                                         고를 수는 있다 — 다시 갈 이유는 사람이 안다 -->
                                    <label class="itin-check" :class="{done: isVisited(p.id)}"
                                           :title="isVisited(p.id) ? '이미 다녀온 곳입니다' : ''">
                                        <input type="checkbox" :checked="itinProperties.includes(p.id)"
                                               @change="toggleItineraryProperty(p.id)">
                                        <span x-text="propertyTitle(p)"></span>
                                        <small x-show="isVisited(p.id)" class="itin-check-done">다녀옴</small>
                                        <small x-text="fmtWon(p.priceDeposit)"></small>
                                    </label>
                                </template>
                            </div>
                            <p class="form-error" x-show="error" x-text="error"></p>
                            <!-- 계획 저장을 없앴다 (설계 I197). 계산이 곧 저장이었고,
                                 저장이 더 주던 것은 방문 체크 하나였다 — 결과 층으로 옮겼다.
                                 초기화는 반대쪽 끝에 둔다 (설계 I206) — 계산 옆에 붙여 두면
                                 눌러야 할 것 옆에 지우는 것이 있게 된다 -->
                            <div class="itin-actions">
                                <button class="btn btn-ghost" @click="clearItineraryResult()"
                                        x-show="itinResult" :disabled="loading">경로 초기화</button>
                                <button class="btn btn-primary" @click="optimizeItinerary()" :disabled="loading">경로 계산</button>
                            </div>
                        </div>

                        <template x-if="itinResult">
                            <div class="itin-result card">
                                <p class="itin-total">예상 이동시간 합계: <b x-text="itinResult.totalMinutes + '분'"></b></p>
                                <!-- 합계를 믿을 수 있는지 함께 말한다 (설계 I270) -->
                                <p class="itin-warn" x-show="itinTotalNote()" x-text="itinTotalNote()"></p>

                                <!-- 지도 색이 무엇을 뜻하는지 (설계 I195).
                                     범례가 없으면 빨간 선이 정체인지 다른 노선인지 알 수 없다 -->
                                <div class="itin-legend" x-show="itinMode === 'DRIVING'">
                                    <span class="lg"><i style="background:#d64545"></i>정체</span>
                                    <span class="lg"><i style="background:#e08b2f"></i>지체</span>
                                    <span class="lg"><i style="background:#e0c22f"></i>서행</span>
                                    <span class="lg"><i style="background:#3f9e56"></i>원활</span>
                                    <span class="lg"><i style="background:#8a8378"></i>정보없음</span>
                                </div>
                                <div class="itin-legend" x-show="itinMode === 'TRANSIT'">
                                    <template x-for="lg in transitLegend()" :key="lg.color">
                                        <span class="lg"><i :style="'background:' + lg.color"></i><span x-text="lg.name"></span></span>
                                    </template>
                                </div>

                                <!-- 순서와 가는 길을 <b>한 묶음으로</b> 엮는다 (설계 I192).
                                     따로 두면 "2번 집에 어떻게 가지"를 눈으로 맞춰 봐야 한다 -->
                                <ol class="itin-route">
                                    <template x-for="(id, i) in itinResult.orderedPropertyIds" :key="id">
                                        <li class="itin-route-item">
                                            <div class="itin-stop" :class="{done: isVisited(id)}">
                                                <span class="itin-num" x-text="i + 1"></span>
                                                <span x-text="propertyName(id)"></span>
                                                <!-- 몇 시에 닿는지 (설계 I194) -->
                                                <span class="itin-time" x-show="legFor(i) && arrivalAt(i)"
                                                      x-text="arrivalAt(i) + ' 도착'"></span>
                                                <!-- 방문완료 (설계 I197). 현장에서 누르는 것이라 순번 줄에 둔다 -->
                                                <!-- 쾌적함으로 켜진 것은 못 끈다 (설계 I228).
                                                     근거가 채점이므로 끄려면 그 점수를 지워야 하는데,
                                                     그건 채점 화면의 일이다 -->
                                                <label class="itin-visit"
                                                       :class="{locked: visitedByComfort(id)}"
                                                       :title="visitedByComfort(id)
                                                           ? '공간의 쾌적함을 매겨 다녀온 곳으로 봅니다 (설계 I121)'
                                                           : ''">
                                                    <input type="checkbox" :checked="isVisited(id)"
                                                           :disabled="visitedByComfort(id)"
                                                           @change="toggleVisited(id)">
                                                    <span x-text="visitedByComfort(id) ? '방문완료 (채점됨)' : '방문완료'"></span>
                                                </label>
                                            </div>
                                            <template x-if="legFor(i)">
                                                <div class="itin-route-legs">
                                                    <div class="itin-leg-head">
                                                        <span x-text="legTitle(legFor(i))"></span>
                                                        <b x-text="legMinutesLabel(legFor(i))"></b>
                                                    </div>
                                                    <template x-for="(step, j) in (legFor(i).steps || [])" :key="j">
                                                        <div class="itin-step" :class="'is-' + step.kind.toLowerCase()">
                                                            <span class="itin-step-ic" x-text="stepIcon(step)"></span>
                                                            <span x-text="legStepText(step)"></span>
                                                        </div>
                                                    </template>
                                                    <!-- 자가용인데 도로를 못 받았으면 시간만이라도.
                                                         <b>시간마저 못 받았으면 이 줄을 안 그린다</b> (설계 I270) —
                                                         "약 null분" 이 그것이었다 -->
                                                    <div class="itin-step is-road"
                                                         x-show="!(legFor(i).steps || []).length
                                                                 && legFor(i).minutes != null">
                                                        <span class="itin-step-ic">🚗</span>
                                                        <span x-text="'약 ' + legFor(i).minutes + '분'"></span>
                                                    </div>
                                                </div>
                                            </template>
                                        </li>
                                    </template>
                                </ol>
                            </div>
                        </template>

                    </div>

                    <div x-show="view==='me'">
                        <div class="sec-head"><h2>내 프로필</h2></div>
                        <!-- 순서는 쓰는 빈도다 (설계 I168): 수정 → 부채 → 비밀번호 → 그룹 → 탈퇴.
                             읽기 전용 요약 카드는 뺐다 — 바로 아래 수정 폼에 같은 값이 있다 -->
                        <template x-if="profile">
                        <div>
                        <div class="card profile-panel">
                            <h4 class="profile-title">프로필 수정</h4>
                            <div class="form-grid">
                                <label>닉네임
                                    <input type="text" x-model="profileForm.nickname" placeholder="리스트·의견에 표시되는 이름">
                                </label>
                                <label class="span2">직장 주소
                                    <div class="workplace-search">
                                        <input type="text" x-model="profileForm.workplaceName" placeholder="주소 검색 버튼을 눌러 선택하세요" readonly>
                                        <button class="btn" type="button" @click="searchPostcodeFor('profile')">주소 검색</button>
                                    </div>
                                </label>
                                <label>위도
                                    <input type="number" step="0.000001" x-model="profileForm.workplaceLat" readonly placeholder="주소 선택 시 자동 입력">
                                </label>
                                <label>경도
                                    <input type="number" step="0.000001" x-model="profileForm.workplaceLng" readonly placeholder="주소 선택 시 자동 입력">
                                </label>
                                <label class="span2">보유 현금 (총 자산에서 가용 가능한 금액 - 원)
                                    <span class="money-row">
                                        <input type="text" inputmode="numeric" :value="profileForm.availableBudget" @input="profileForm.availableBudget = numericInput($event)" placeholder="300000000" style="width:50%">
                                        <span class="money-hint" x-show="moneyHint(profileForm.availableBudget)"
                                              x-text="moneyHint(profileForm.availableBudget)"></span>
                                    </span>
                                    <span class="settings-note">대출을 뺀 동원 가능한 현금입니다. 바꾸면 전 매물의 가격 점수가 다시 계산됩니다.</span>
                                </label>
                                <label>연소득 (원)
                                    <span class="money-row">
                                        <input type="text" inputmode="numeric" :value="profileForm.annualIncome" @input="profileForm.annualIncome = numericInput($event)" placeholder="50000000" style="width:50%">
                                        <span class="money-hint" x-show="moneyHint(profileForm.annualIncome)"
                                              x-text="moneyHint(profileForm.annualIncome)"></span>
                                    </span>
                                    <span class="settings-note">세전 기준. 대출 한도(DSR) 계산에 씁니다.</span>
                                </label>
                                <label>기존 대출액 (원)
                                    <span class="money-row">
                                        <input type="text" inputmode="numeric" :value="profileForm.existingLoan" @input="profileForm.existingLoan = numericInput($event)" placeholder="0" style="width:50%">
                                        <span class="money-hint" x-show="moneyHint(profileForm.existingLoan)"
                                              x-text="moneyHint(profileForm.existingLoan)"></span>
                                    </span>
                                    <span class="settings-note">대출액수만큼 DSR 여력에서 빠집니다.</span>
                                </label>
                            </div>
                            <p class="form-error" x-show="error" x-text="error"></p>
                            <div class="panel-actions">
                                <button class="btn btn-primary" @click="saveProfile()" :disabled="loading">
                                    <span x-text="loading ? '저장 중…' : '프로필 저장'"></span>
                                </button>
                            </div>
                        </div>
                        <div class="card profile-panel" style="margin-top:14px;">
                            <h4 class="profile-title">기존 부채</h4>
                            <p class="settings-note">
                                종류마다 DSR 산정만기가 달라 같은 금액이라도 부담이 다릅니다.
                                마이너스통장은 쓴 금액이 아니라 <b>한도</b>를 넣어 주세요.
                            </p>
                            <template x-for="(d, i) in debtForm" :key="i">
                                <div class="debt-row">
                                    <select x-model="d.type">
                                        <template x-for="o in debtTypes" :key="o.code">
                                            <option :value="o.code" x-text="o.label"></option>
                                        </template>
                                    </select>
                                    <span class="money-row debt-amount">
                                        <input type="number" min="0" x-model="d.amount" placeholder="0">
                                        <span class="money-hint" x-show="moneyHint(d.amount)"
                                              x-text="moneyHint(d.amount)"></span>
                                    </span>
                                    <button class="btn btn-xs" type="button" @click="removeDebt(i)">삭제</button>
                                </div>
                            </template>
                            <div class="debt-actions">
                                <button class="btn btn-xs" type="button" @click="addDebt()">항목 추가</button>
                                <button class="btn btn-sm btn-primary" type="button" @click="saveDebts()"
                                        :disabled="loading">저장</button>
                            </div>
                            <template x-if="debts.length > 0">
                                <div class="debt-summary">
                                    <template x-for="d in debts" :key="d.type">
                                        <div class="debt-summary-row">
                                            <span x-text="d.typeLabel"></span>
                                            <span class="debt-term"
                                                  x-text="d.interestOnly ? '이자만' : ('DSR ' + d.dsrYears + '년')"></span>
                                            <b x-text="'연 ' + fmtWon(d.annualPayment)"></b>
                                        </div>
                                    </template>
                                </div>
                            </template>
                        </div>
                        <div class="card profile-panel" style="margin-top:14px;">
                            <h4 class="profile-title">비밀번호 변경</h4>
                            <div class="panel-actions">
                                <button class="btn" @click="openChangePw()">비밀번호 변경</button>
                            </div>
                        </div>
                        <template x-if="myGroup">
                        <div class="card profile-panel" style="margin-top:14px;">
                            <h4 class="profile-title">그룹</h4>
                            <div class="form-grid">
                                <label class="span2">그룹 이름
                                    <div class="group-name-row">
                                        <input type="text" x-model="groupForm.name" placeholder="그룹 이름">
                                        <button class="btn btn-sm" type="button" @click="renameGroup()"
                                                :disabled="loading || !groupForm.name">이름 변경</button>
                                    </div>
                                    <span class="settings-note">그룹의 누구나 바꿀 수 있습니다.</span>
                                </label>

                                <label class="span2">알림 받을 Slack 웹훅
                                    <div class="group-name-row">
                                        <input type="url" x-model="groupForm.slackWebhookUrl"
                                               placeholder="https://hooks.slack.com/services/...">
                                        <button class="btn btn-sm" type="button" @click="saveWebhook()"
                                                :disabled="loading">저장</button>
                                        <button class="btn btn-sm" type="button" @click="testWebhook()"
                                                :disabled="loading || !groupForm.slackWebhookUrl">테스트</button>
                                    </div>
                                    <span class="settings-note">매물 등록·판매완료 알림이 이 채널로 갑니다.
                                        비워 두면 알림이 나가지 않습니다.</span>
                                </label>

                                <label class="span2">초대 코드 만들기
                                    <button class="btn btn-sm" type="button" @click="createInvite()"
                                            :disabled="loading">코드 생성</button>
                                    <template x-if="inviteCode">
                                        <span class="invite-box">
                                            <b class="invite-code" x-text="inviteCode.code"></b>
                                            <span class="invite-expiry"
                                                  x-text="'24시간 뒤 만료 · ' + fmtTime(inviteCode.expiresAt)"></span>
                                        </span>
                                    </template>
                                    <span class="settings-note">이 코드를 받은 사람이 우리 그룹으로 들어옵니다.
                                        전달은 직접 해주세요.</span>
                                </label>

                                <label class="span2">다른 그룹으로 이동
                                    <div class="group-name-row">
                                        <input type="text" x-model="joinForm.code" maxlength="8"
                                               placeholder="받은 초대 코드 8자리">
                                        <button class="btn btn-sm" type="button" @click="confirmJoinGroup()"
                                                :disabled="loading || !joinForm.code">그룹 가입</button>
                                    </div>
                                    <span class="settings-note">지금 그룹에서 나가게 됩니다.</span>
                                </label>
                            </div>
                        </div>
                        </template>
                        <div class="card profile-panel profile-danger" style="margin-top:14px;"
                             x-show="profile && profile.role !== 'ADMIN'">
                            <h4 class="profile-title">회원 탈퇴</h4>
                            <p class="settings-note">
                                닉네임을 제외한 모든 정보가 삭제됩니다.
                                올리신 매물과 코멘트는 그룹에 남습니다.
                            </p>
                            <div class="group-name-row" style="margin-top:8px;">
                                <input type="password" x-model="withdrawForm.password"
                                       autocomplete="current-password" placeholder="비밀번호 확인">
                                <button class="btn btn-sm btn-danger" type="button" @click="confirmWithdraw()"
                                        :disabled="loading || !withdrawForm.password">탈퇴</button>
                            </div>
                        </div>
                        </div>
                        </template>
                    </div>

                    <!-- 그룹 정보 (설계 I123). 모달이 아니라 화면이다 —
                         구성원·초대 코드까지 함께 보는 자리라 좁은 상자에 넣지 않는다 -->
                    <div x-show="view==='group'">
                        <div class="sec-head"><h2>그룹 정보</h2></div>
                        <div class="progress-strip" x-show="isLoading('groupDetail')" x-cloak>
                            <span class="progress-strip-label">데이터 로딩 중입니다…</span>
                            <div class="progress-strip-bar"><i></i></div>
                        </div>
                        <template x-if="!groupDetail && !isLoading('groupDetail')">
                            <div class="empty">
                                <div class="empty-ic">◌</div>
                                <h4>속한 그룹이 없습니다</h4>
                                <p>초대 코드로 그룹에 가입하거나 새 그룹을 만들어 주세요.</p>
                            </div>
                        </template>
                        <template x-if="groupDetail">
                            <div class="group-view">
                                <!-- 이 앱은 모아서 집을 사려고 만든 것이라 합계가 먼저 보인다 -->
                                <div class="group-stats">
                                    <div class="group-stat">
                                        <span>그룹 보유 현금</span>
                                        <b x-text="fmtWon(groupDetail.totalCash)"></b>
                                        <small x-text="groupDetail.memberCount + '명 합산'"></small>
                                    </div>
                                    <div class="group-stat">
                                        <span>관심 매물</span>
                                        <b x-text="groupDetail.propertyCount + '건'"></b>
                                        <small>그룹이 함께 보고 있는 매물</small>
                                    </div>
                                </div>

                                <div class="card group-panel">
                                    <h4 class="card-title">그룹 설정</h4>
                                    <div class="form-grid">
                                        <label class="span2">그룹 이름
                                            <div class="workplace-search">
                                                <input type="text" x-model="groupForm.name" placeholder="그룹 이름">
                                                <button class="btn" type="button" @click="renameGroup()"
                                                        :disabled="loading || !groupForm.name">변경</button>
                                            </div>
                                            <span class="settings-note">그룹의 누구나 바꿀 수 있습니다.</span>
                                        </label>
                                        <label class="span2">Slack Webhook URL
                                            <div class="workplace-search">
                                                <input type="url" x-model="groupForm.slackWebhookUrl"
                                                       placeholder="https://hooks.slack.com/services/...">
                                                <button class="btn" type="button" @click="saveWebhook()"
                                                        :disabled="loading">저장</button>
                                                <button class="btn" type="button" @click="testWebhook()"
                                                        :disabled="loading || !groupForm.slackWebhookUrl">테스트</button>
                                            </div>
                                            <span class="settings-note">비워 두면 알림을 보내지 않습니다.
                                                매물 등록·삭제, 코멘트, 쾌적함 평가가 이 주소로 갑니다.</span>
                                        </label>
                                    </div>
                                </div>

                                <div class="card group-panel">
                                    <h4 class="card-title">구성원 <span x-text="groupDetail.memberCount + '명'"></span></h4>
                                    <div class="table-wrap group-table">
                                    <table>
                                        <thead>
                                        <tr><th>닉네임</th><th>직장</th><th class="num">보유 현금</th><th>상태</th></tr>
                                        </thead>
                                        <tbody>
                                        <template x-for="m in groupDetail.members" :key="m.id">
                                            <tr>
                                                <td x-text="m.nickname"></td>
                                                <!-- 칸이 좁아 줄바꿈되므로 전체 주소는 툴팁으로 (설계 I165) -->
                                                <td :title="m.workplaceName || ''" x-text="m.workplaceName || '-'"></td>
                                                <td class="num" x-text="fmtWon(m.availableBudget)"></td>
                                                <td><span class="badge" :class="m.enabled ? 'b-on' : 'b-off'"
                                                          x-text="m.enabled ? '활성' : '비활성'"></span></td>
                                            </tr>
                                        </template>
                                        </tbody>
                                    </table>
                                    </div>
                                    <p class="settings-note">열람만 가능합니다. 프로필 수정은 각자 합니다.</p>
                                </div>

                                <div class="card group-panel">
                                    <h4 class="card-title">초대 코드</h4>
                                    <p class="settings-note">코드는 <b>24시간</b> 동안만 쓸 수 있고, 새로 만들면 이전 코드는 사라집니다.</p>
                                    <div class="workplace-search">
                                        <button class="btn btn-primary" type="button"
                                                @click="createInvite()" :disabled="isLoading('invite')">초대 코드 생성</button>
                                    </div>
                                    <template x-if="inviteCode">
                                        <div class="invite-box">
                                            <b x-text="inviteCode.code"></b>
                                            <small x-text="'만료 ' + fmtTime(inviteCode.expiresAt)"></small>
                                        </div>
                                    </template>
                                </div>
                            </div>
                        </template>
                    </div>


                </div>
            </template>
        </aside>
    </main>
</div>

<!-- D1 로그인 모달 -->
<div class="modal" x-show="showLogin" x-cloak>
    <div class="modal-backdrop" @click="closeTopModal()"></div>
    <div class="modal-card modal-login">
        <div class="modal-head">
            <span class="modal-kicker">우리들끼리 부동산 매물 비교 🏡</span>
            <h3 class="modal-title-logo">
                <img src="/image/logo-64.png" alt="" width="28" height="28">
                <span>Halley</span>
            </h3>
            <p>계정 정보를 입력해 들어오세요.</p>
        </div>
        <form class="form" @submit.prevent="login()">
            <label>ID
                <!-- 커서는 focusLogin() 이 옮긴다 (설계 I209).
                     x-effect 는 x-show 모달에서 showLogin 이 거짓일 때 한 번 돌고 말았다 -->
                <input id="loginId" type="text" x-model="loginForm.loginId" autocomplete="username"
                       placeholder="admin" required>
            </label>
            <label>Password
                <input id="loginPassword" type="password" x-model="loginForm.password"
                       autocomplete="current-password" placeholder="••••••••" required>
            </label>
            <!-- ID 저장은 브라우저에, 로그인 유지는 서버 세션에 (설계 I190) -->
            <div class="login-options">
                <label class="check">
                    <input type="checkbox" x-model="loginForm.rememberId">
                    <span>ID 저장</span>
                </label>
                <label class="check">
                    <input type="checkbox" x-model="loginForm.rememberMe">
                    <span>로그인 상태 유지</span>
                </label>
            </div>
            <p class="form-error" x-show="error" x-text="error"></p>
            <button class="btn btn-primary btn-block" type="submit" :disabled="loading">
                <span x-text="loading ? '로그인 중…' : '로그인'"></span>
            </button>
            <!-- 회원가입이 닫혀 있으면 링크 자체를 감춘다 (설계 I95). 서버도 막는다 -->
            <p class="login-alt" x-show="signUpOpen">
                처음이신가요?
                <a href="#" @click.prevent="openSignUp()">회원 가입</a>
            </p>
        </form>
    </div>
</div>

<!-- D1-2 회원 가입 모달 (설계 I89 · 규칙 13·14) -->
<div class="modal" x-show="showSignUp" x-cloak>
    <div class="modal-backdrop" @click="closeTopModal()"></div>
    <div class="modal-card modal-login">
        <div class="modal-head">
            <span class="modal-kicker">우리들끼리 부동산 매물 비교 🏡</span>
            <h3>회원 가입</h3>
            <p>가입하면 나만의 그룹이 만들어집니다.</p>
        </div>
        <form class="form" @submit.prevent="signUp()">
            <label>ID
                <input type="text" x-model="signUpForm.loginId" autocomplete="username" required
                       x-ref="signUpId" x-effect="if (showSignUp) $nextTick(() => $refs.signUpId.focus())">
            </label>
            <label>닉네임
                <span class="nickname-row">
                    <input type="text" x-model="signUpForm.nickname"
                           @input="signUpNickname = null" placeholder="리스트·코멘트에 표시됩니다" required>
                    <button class="btn btn-xs" type="button" @click="checkNickname('signUp')"
                            :disabled="!signUpForm.nickname">중복 확인</button>
                </span>
                <span class="nickname-hint" :class="signUpNickname === true ? 'is-ok' : 'is-bad'"
                      x-show="signUpNickname !== null"
                      x-text="signUpNickname ? '사용할 수 있는 닉네임입니다' : '이미 쓰이는 닉네임입니다'"></span>
            </label>
            <label>Password
                <input type="password" x-model="signUpForm.password" autocomplete="new-password"
                       minlength="8" placeholder="8자 이상" required>
            </label>
            <p class="form-error" x-show="error" x-text="error"></p>
            <button class="btn btn-primary btn-block" type="submit" :disabled="loading">
                <span x-text="loading ? '가입 중…' : '가입하고 시작하기'"></span>
            </button>
            <p class="login-alt">
                이미 계정이 있으신가요?
                <a href="#" @click.prevent="openLogin()">로그인</a>
            </p>
        </form>
    </div>
</div>

