<!-- D4/D5 사용자 생성·수정 모달 -->
<div class="modal modal-stacked" x-show="showUserForm" x-cloak>
    <div class="modal-backdrop" @click="closeTopModal()"></div>
    <div class="modal-card modal-wide">
        <div class="modal-head">
            <span class="modal-kicker">사용자 관리</span>
            <h3 x-text="editingUserId ? '사용자 정보 수정' : '사용자 추가'"></h3>
        </div>
        <!-- 응답이 늦으면 진행 막대를 띄운다 (설계 I115) -->
        <div class="progress-strip" x-show="isLoading('groups')" x-cloak>
            <span class="progress-strip-label">데이터 로딩 중입니다…</span>
            <div class="progress-strip-bar"><i></i></div>
        </div>
        <form class="form" @submit.prevent="saveUser()">
            <div class="form-grid">
                <!-- label이 아니라 div다 (설계 I104). label 안에 버튼을 두면 라벨 아무 데나
                     눌러도 버튼이 눌려, 주변을 클릭할 때마다 그룹이 만들어졌다 -->
                <div class="span2 group-admin">
                    <div class="group-admin-head">
                        <b>지금 있는 그룹</b>
                    </div>
                    <div class="group-admin-list">
                        <template x-for="g in groups" :key="g.id">
                            <span class="group-badge"
                                  :class="g.memberCount === 0 ? 'is-empty' : ''"
                                  x-text="g.name + ' · ' + g.memberCount + '명'"></span>
                        </template>
                        <span class="settings-note" x-show="groups.length === 0">그룹이 없습니다.</span>
                    </div>
                    <div class="group-admin-create">
                        <input type="text" x-model="newGroupName" maxlength="100"
                               placeholder="그룹 이름 (비우면 자동으로 지어집니다)"
                               @keydown.enter.prevent="createGroupAsAdmin()">
                        <button class="btn btn-sm" type="button" @click="createGroupAsAdmin()"
                                :disabled="loading">그룹 만들기</button>
                    </div>
                    <span class="settings-note">이름은 겹칠 수 없습니다.
                        <b>회원이 없는 그룹은 2개까지</b>만 둘 수 있습니다.</span>
                </div>
                <label>아이디
                    <input type="text" x-model="userForm.loginId" placeholder="로그인에 쓰는 아이디" required>
                </label>
                <label>닉네임
                    <input type="text" x-model="userForm.nickname" required>
                </label>
                <!-- x-if 템플릿은 자식이 여럿이면 첫 번째만 렌더링한다 (설계 I100).
                     그래서 비밀번호·역할이 화면에서 사라져 있었다. 각 칸에 x-show를 건다 -->
                <label>소속 그룹
                    <select x-model="userForm.groupId">
                        <option value="" x-text="editingUserId ? '그대로 두기' : '새 그룹 자동 생성'"></option>
                        <template x-for="g in groups" :key="g.id">
                            <option :value="g.id"
                                    x-text="g.name + ' (' + g.memberCount + '명)'"></option>
                        </template>
                    </select>
                    <span class="settings-note" x-show="!editingUserId">비워 두면 이 회원만의 새 그룹이
                        만들어집니다. 관리자는 그룹에 속하지 않습니다.</span>
                    <!-- 마지막 한 사람이 빠지면 그 그룹과 매물이 함께 사라진다 (규칙 4) -->
                    <span class="settings-note" x-show="editingUserId">
                        옮기면 원래 그룹의 매물은 이 회원에게 보이지 않습니다.
                        <b>원래 그룹에 아무도 남지 않으면 그 그룹과 매물이 모두 삭제됩니다.</b>
                    </span>
                </label>
                <label x-show="!editingUserId">비밀번호
                    <input type="password" x-model="userForm.password" minlength="8"
                           :required="!editingUserId" autocomplete="new-password"
                           placeholder="8자 이상 · 첫 로그인 때 본인이 바꿉니다">
                </label>

                <label class="span2">직장 주소
                    <div class="workplace-search">
                        <input type="text" x-model="userForm.workplaceName"
                               placeholder="주소 검색 버튼을 눌러 선택하세요" readonly>
                        <button class="btn" type="button" @click="searchPostcodeFor('user')">주소 검색</button>
                    </div>
                    <!-- 좌표는 주소를 고르면 자동으로 채워진다. 직접 넣을 값이 아니라 바로 아래 둔다 -->
                    <span class="coord-row">
                        <span class="coord-cell">
                            <i>위도</i>
                            <input type="number" step="0.000001" x-model="userForm.workplaceLat"
                                   readonly placeholder="주소 선택 시 자동 입력">
                        </span>
                        <span class="coord-cell">
                            <i>경도</i>
                            <input type="number" step="0.000001" x-model="userForm.workplaceLng"
                                   readonly placeholder="주소 선택 시 자동 입력">
                        </span>
                    </span>
                    <span class="settings-note">직장 좌표가 있어야 <b>직주근접</b> 항목이 채점됩니다.</span>
                </label>
                <label class="span2">보유 현금 (총 자산에서 가용 가능한 금액 - 원)
                    <span class="money-row">
                        <input type="text" inputmode="numeric" :value="userForm.availableBudget" @input="userForm.availableBudget = numericInput($event)" style="width:50%">
                        <span class="money-hint" x-show="moneyHint(userForm.availableBudget)"
                              x-text="moneyHint(userForm.availableBudget)"></span>
                    </span>
                </label>
                <label>연소득
                    <span class="money-row">
                        <input type="text" inputmode="numeric" :value="userForm.annualIncome" @input="userForm.annualIncome = numericInput($event)" style="width:50%">
                        <span class="money-hint" x-show="moneyHint(userForm.annualIncome)"
                              x-text="moneyHint(userForm.annualIncome)"></span>
                    </span>
                </label>
                <label>기존 대출액
                    <span class="money-row">
                        <input type="text" inputmode="numeric" :value="userForm.existingLoan" @input="userForm.existingLoan = numericInput($event)" style="width:50%">
                        <span class="money-hint" x-show="moneyHint(userForm.existingLoan)"
                              x-text="moneyHint(userForm.existingLoan)"></span>
                    </span>
                </label>
            </div>
            <p class="form-error" x-show="error" x-text="error"></p>
            <button class="btn btn-primary btn-block" type="submit" :disabled="loading">
                <span x-text="editingUserId ? '저장' : '생성'"></span>
            </button>
        </form>
    </div>
</div>

<!-- D11 중개인 관리 모달 -->
<div class="modal" x-show="showAgentModal" x-cloak>
    <div class="modal-backdrop" @click="closeTopModal()"></div>
    <div class="modal-card modal-wide">
        <div class="modal-head">
            <span class="modal-kicker">중개인</span>
            <h3 x-text="propertyTitle(agentProperty?.property)"></h3>
            <p>이 매물을 담당하는 중개인을 연결합니다. 대표(1순위) 중개인은 1명입니다.</p>
        </div>
        <div class="card table-wrap">
            <table>
                <thead><tr><th>사무소</th><th>담당</th><th>연락처</th><th>대표</th><th></th></tr></thead>
                <tbody>
                <template x-if="agentLinks.length === 0">
                    <tr><td colspan="5" class="empty-cell">연결된 중개인이 없습니다</td></tr>
                </template>
                <template x-for="a in agentLinks" :key="a.agentId">
                    <tr>
                        <td class="strong" x-text="a.officeName || '-'"></td>
                        <td x-text="a.agentName || '-'"></td>
                        <td x-text="a.phone || a.mobile || '-'"></td>
                        <td><input type="radio" :checked="a.isPrimary" @change="setPrimaryAgent(a.agentId)"></td>
                        <td><button class="btn-link danger" @click="unlinkAgent(a.agentId)">해제</button></td>
                    </tr>
                </template>
                </tbody>
            </table>
        </div>

        <div class="form-grid" style="margin-top:14px;">
            <label class="span2">기존 중개인 검색
                <div class="workplace-search">
                    <input type="text" x-model="agentQuery" placeholder="사무소/담당명 검색" @keyup.enter="searchAgents()">
                    <button class="btn" @click="searchAgents()">검색</button>
                </div>
            </label>
            <template x-if="agentResults.length > 0">
                <div class="workplace-results span2">
                    <template x-for="r in agentResults" :key="r.id">
                        <button class="workplace-result" @click="addLinkedAgent(r.id)">
                            <span x-text="(r.officeName || '-') + ' · ' + (r.agentName || '-')"></span>
                            <small x-text="r.phone || r.mobile || ''"></small>
                        </button>
                    </template>
                </div>
            </template>
            <label>사무소명 <input type="text" x-model="newAgentForm.officeName"></label>
            <label>담당 <input type="text" x-model="newAgentForm.agentName"></label>
            <label>전화 <input type="text" x-model="newAgentForm.phone"></label>
            <label>휴대폰 <input type="text" x-model="newAgentForm.mobile"></label>
        </div>
        <p class="form-error" x-show="error" x-text="error"></p>
        <div class="paste-actions">
            <button class="btn" @click="createNewAgent()" :disabled="loading">새 중개인 등록 + 연결</button>
        </div>
    </div>
</div>

<!-- D12 사진 업로드 모달 -->
<div class="modal" x-show="showPhotoModal" x-cloak>
    <div class="modal-backdrop" @click="closeTopModal()"></div>
    <div class="modal-card modal-wide">
        <button class="modal-close" @click="closePhotoModal()">×</button>
        <div class="modal-head">
            <span class="modal-kicker">이미지</span>
            <h3 x-text="propertyTitle(photoProperty?.property)"></h3>
            <p>업로드 시 EXIF 방향을 보정하고 원본(최대 1920)·썸네일(320)로 저장합니다.</p>
        </div>
        <!-- 응답이 늦으면 진행 막대를 띄운다 (설계 I115) -->
        <div class="progress-strip" x-show="isLoading('photos')" x-cloak>
            <span class="progress-strip-label">데이터 로딩 중입니다…</span>
            <div class="progress-strip-bar"><i></i></div>
        </div>

        <!-- 평면도: 매물당 한 장. 올리면 기존 것을 대체한다 (설계 I63) -->
        <section class="img-sec">
            <div class="img-sec-head">
                <h4>평면도</h4>
                <span class="img-sec-note">한 장만 둡니다. 새로 올리면 기존 평면도를 대체합니다.</span>
            </div>
            <template x-if="floorPlan">
                <div class="img-single">
                    <button class="photo-item" @click="openPhotoViewer(photoImages.indexOf(floorPlan), photoImages)">
                        <img :src="floorPlan.storagePath" alt="평면도">
                    </button>
                    <button class="btn btn-xs btn-danger" @click="removeImage(floorPlan)" :disabled="loading">삭제</button>
                </div>
            </template>
            <label class="img-drop">
                <input type="file" accept="image/*" @change="uploadImages($event, 'FLOOR_PLAN')">
                <span x-text="floorPlan ? '평면도 교체하기' : '평면도 올리기'"></span>
            </label>
        </section>

        <!-- 매물사진: 여러 장 -->
        <section class="img-sec">
            <div class="img-sec-head">
                <h4>매물사진</h4>
                <span class="img-sec-note" x-text="photos.length + '장'"></span>
            </div>
            <div class="photo-grid" x-show="photos.length > 0">
                <template x-for="img in photos" :key="img.id">
                    <div class="photo-cell">
                        <button class="photo-item" @click="openPhotoViewer(photoImages.indexOf(img), photoImages)">
                            <img :src="img.storagePath" alt="매물사진">
                        </button>
                        <button class="photo-del" @click="removeImage(img)" :disabled="loading" title="삭제">×</button>
                    </div>
                </template>
            </div>
            <p class="photo-empty" x-show="photos.length === 0">등록된 매물사진이 없습니다.</p>
            <label class="img-drop">
                <input type="file" accept="image/*" multiple @change="uploadImages($event, 'PHOTO')">
                <span>매물사진 올리기 (여러 장 선택 가능)</span>
            </label>
        </section>

        <p class="paste-hint" x-show="loading">업로드 중…</p>
        <p class="form-error" x-show="error" x-text="error"></p>
    </div>
</div>

<!-- D13 사진 뷰어 라이트박스 -->
<div class="lightbox" x-show="photoViewerIndex >= 0" x-cloak @click.self="closePhotoViewer()">
    <button class="lightbox-close" @click="closePhotoViewer()">×</button>
    <button class="lightbox-nav prev" @click="photoPrev()" x-show="photoViewerIndex > 0">‹</button>
    <img :src="photoViewerIndex >= 0 && viewerImages[photoViewerIndex] ? viewerImages[photoViewerIndex].storagePath : ''" alt="">
    <button class="lightbox-nav next" @click="photoNext()" x-show="photoViewerIndex < viewerImages.length - 1">›</button>
    <!-- 몇 번째 장인지 (설계 I203). 방향키로 넘길 수 있다는 표시이기도 하다 -->
    <span class="lightbox-count" x-show="viewerImages.length > 1"
          x-text="(photoViewerIndex + 1) + ' / ' + viewerImages.length"></span>
</div>

<!-- D17 확인 모달 -->
<div class="modal modal-top" x-show="confirmState" x-cloak>
    <div class="modal-backdrop" @click="closeTopModal()"></div>
    <div class="modal-card">
        <div class="modal-head">
            <span class="modal-kicker">확인</span>
            <h3 x-text="confirmState?.title"></h3>
            <p x-text="confirmState?.message"></p>
        </div>
        <div class="paste-actions">
            <button class="btn btn-ghost" @click="confirmNo()">취소</button>
            <button class="btn btn-primary" @click="confirmYes()">확인</button>
        </div>
    </div>
</div>

<!-- M3 사용자 관리 모달 (ADMIN 전용) -->
<div class="modal" x-show="showUsers" x-cloak>
    <div class="modal-backdrop" @click="closeTopModal()"></div>
    <div class="modal-card modal-xwide">
        <button class="modal-close" @click="closeUsers()">×</button>
        <div class="modal-head">
            <span class="modal-kicker">사용자 관리</span>
            <h3>계정 <span x-text="users.length"></span>명</h3>
            <p>가입 절차가 없는 폐쇄형 서비스입니다. 계정은 관리자가 이곳에서 만들고 관리합니다.</p>
        </div>

        <!-- 발급한 임시 비밀번호 (설계 I213). 서버는 이때 한 번만 알려 준다 —
             저장된 것은 해시라 닫으면 아무도 다시 못 읽는다 -->
        <template x-if="tempPassword">
            <div class="temp-pw">
                <div class="temp-pw-head">
                    <b><span x-text="tempPassword.nickname"></span>님의 임시 비밀번호</b>
                    <button class="btn btn-xs" @click="dismissTempPassword()">닫기</button>
                </div>
                <div class="temp-pw-body">
                    <code x-text="tempPassword.password"></code>
                    <button class="btn btn-xs" @click="copyTempPassword()"
                            x-text="tempPassword.copied ? '복사됨' : '복사'"></button>
                </div>
                <p class="temp-pw-note">
                    <b x-text="tempPassword.loginId"></b> 계정으로 이 비밀번호를 전달하십시오.
                    <b>닫으면 다시 볼 수 없습니다</b> — 저장된 값은 해시라 서버도 모릅니다.
                    첫 로그인 때 본인이 새 비밀번호를 정하게 됩니다.
                </p>
            </div>
        </template>
        <!-- 응답이 늦으면 진행 막대를 띄운다 (설계 I115) -->
        <div class="progress-strip" x-show="isLoading('users')" x-cloak>
            <span class="progress-strip-label">데이터 로딩 중입니다…</span>
            <div class="progress-strip-bar"><i></i></div>
        </div>
        <div class="card table-wrap">
            <table>
                <thead>
                <tr><th>ID</th><th>닉네임</th><th>그룹</th><th>역할</th><th>보유 현금</th><th>연소득</th><th>상태</th><th>관리</th></tr>
                </thead>
                <tbody>
                <template x-for="u in users" :key="u.id">
                    <tr>
                        <td class="strong" x-text="u.loginId"></td>
                        <td x-text="u.nickname"></td>
                        <td><span class="group-badge" x-text="u.groupName || '—'"></span></td>
                        <td><span class="badge" :class="u.role==='ADMIN' ? 'b-admin' : 'b-mem'" x-text="u.role==='ADMIN' ? '관리자' : '회원'"></span></td>
                        <td class="num" x-text="fmtWon(u.availableBudget)"></td>
                        <td class="num" x-text="fmtWon(u.annualIncome)"></td>
                        <td><span class="badge" :class="u.enabled ? 'b-on' : 'b-off'" x-text="u.enabled ? '활성' : '비활성'"></span></td>
                        <td>
                            <div class="row-actions">
                                <button class="btn btn-xs" @click="openEditUser(u)">정보 수정</button>
                                <button class="btn btn-xs" @click="resetUserPassword(u)">비번 리셋</button>
                                <button class="btn btn-xs btn-danger" @click="removeUser(u)">삭제</button>
                            </div>
                        </td>
                    </tr>
                </template>
                </tbody>
            </table>
        </div>
        <p class="form-error" x-show="error" x-text="error"></p>
        <div class="panel-actions">
            <button class="btn btn-primary" @click="openAddUser()">+ 사용자 추가</button>
        </div>
    </div>
</div>

<!-- M6 시스템 설정 모달 (ADMIN 전용) -->
<div class="modal" x-show="showSettings" x-cloak>
    <div class="modal-backdrop" @click="closeTopModal()"></div>
    <div class="modal-card modal-xwide">
        <button class="modal-close" @click="closeSettings()">×</button>
        <div class="modal-head">
            <span class="modal-kicker">시스템 설정</span>
            <h3>배치 · 대출 파라미터</h3>
            <p>런타임에 조정이 필요한 값만 DB에 둡니다. 채점 상수는 코드에 고정되어 있습니다(설계 I41).</p>
        </div>
        <template x-for="cat in settingCategories()" :key="cat">
            <div class="settings-section">
                <h4 x-text="configCategoryLabel(cat)"></h4>
                <div class="card table-wrap">
                    <table>
                        <thead><tr><th>항목</th><th>값</th></tr></thead>
                        <tbody>
                        <template x-for="s in settingsByCategory(cat)" :key="s.configKey">
                            <tr>
                                <td class="strong" x-text="s.description"></td>
                                <!-- 배치가 쓰는 값은 고칠 수 없다 (설계 I185).
                                     입력칸을 열어 두면 고칠 수 있는 것처럼 보이는데 다음 배치가 덮어쓴다 -->
                                <td>
                                    <input class="settings-input" type="text" x-show="settingEditable(s)"
                                           x-model="settingsForm[s.configKey]">
                                    <span class="settings-readonly" x-show="!settingEditable(s)"
                                          x-text="s.configValue"></span>
                                </td>
                            </tr>
                        </template>
                        </tbody>
                    </table>
                </div>
            </div>
        </template>
        <p class="form-error" x-show="error" x-text="error"></p>
        <button class="btn btn-primary settings-save" @click="saveSettings()" :disabled="savingKey === 'settings'">설정 저장</button>

        <!-- AI 모델 (설계 I267). 자리마다 따로 고른다 — 성격이 서로 다르다 -->
        <div class="settings-section">
            <h4>AI 모델</h4>
            <p class="settings-note">
                AI를 쓰는 자리마다 모델을 따로 고릅니다. <b>비워 두면 기본 모델</b>을 씁니다.
                목록은 Anthropic 에서 받아 48시간 담아 둡니다 — 새 모델이 곧바로 안 보이면
                그 때문입니다. <b>*</b> 표시는 Fable 계열처럼 성격이 다른 모델입니다(설계 I278).
            </p>
            <template x-if="!llmModels">
                <p class="m2-empty">모델 목록을 받지 못했습니다. API 키를 확인해 주십시오.</p>
            </template>
            <template x-if="llmModels">
                <div>
                    <div class="card table-wrap">
                        <table>
                            <thead><tr><th>자리</th><th>하는 일</th><th>모델</th></tr></thead>
                            <tbody>
                            <template x-for="f in llmModels.features" :key="f.key">
                                <tr>
                                    <td class="strong" x-text="f.label"></td>
                                    <td x-text="f.description"></td>
                                    <td>
                                        <!--
                                          :selected 를 함께 겁니다 (설계 I280).
                                          x-model 만 두면 <option> 이 x-for 로 붙기 <b>전에</b> 값이
                                          적용돼, 브라우저가 첫 항목("기본 모델")으로 되돌립니다 —
                                          저장은 됐는데 화면만 안 고른 것처럼 보였습니다.
                                        -->
                                        <select class="settings-input" x-model="llmForm[f.key]">
                                            <option value="">기본 모델</option>
                                            <template x-for="m in llmModels.models" :key="m.id">
                                                <option :value="m.id"
                                                        :selected="m.id === llmForm[f.key]"
                                                        x-text="m.displayName + (m.special ? ' *' : '')"></option>
                                            </template>
                                        </select>
                                    </td>
                                </tr>
                            </template>
                            </tbody>
                        </table>
                    </div>
                    <button class="btn btn-primary settings-save" @click="saveLlmModels()" :disabled="savingKey === 'llmModels'">AI 모델 저장</button>
                </div>
            </template>
        </div>

        <!-- 규제 파라미터 (설계 I68) -->
        <div class="settings-section">
            <h4>규제 파라미터</h4>
            <p class="settings-note">
                LTV·DSR·방공제 등 대출 계산에 쓰는 값입니다. 공개 API가 없어 사람이 관리하며,
                <b>규제가 바뀌면 값을 고치는 대신 새 프로파일을 만들어</b> 전환하세요 — 옛 값이 남아야
                과거 산출값을 재현할 수 있습니다.
            </p>
            <div class="reg-profile-bar">
                <label class="loan-select">
                    <span>활성 프로파일</span>
                    <select x-model="regActiveProfile" @change="activateRegProfile()">
                        <template x-for="p in regProfiles" :key="p">
                            <option :value="p" x-text="p"></option>
                        </template>
                    </select>
                </label>
                <div class="reg-profile-new">
                    <input type="text" x-model="regNewProfile" placeholder="새 프로파일 (예: 2026-09-01)">
                    <button class="btn btn-xs" @click="createRegProfile()" :disabled="loading || !regNewProfile.trim()">
                        복제해서 만들기
                    </button>
                </div>
            </div>
            <div class="card table-wrap">
                <table>
                    <thead><tr><th>키</th><th>설명</th><th>값</th></tr></thead>
                    <tbody>
                    <template x-if="regParams.length === 0">
                        <tr><td colspan="3" class="empty-cell">파라미터가 없습니다</td></tr>
                    </template>
                    <template x-for="p in regParams" :key="p.id">
                        <tr>
                            <td class="reg-key" x-text="p.paramKey"></td>
                            <td x-text="p.description"></td>
                            <td><input class="settings-input" type="text" x-model="regParamForm[p.id]"></td>
                        </tr>
                    </template>
                    </tbody>
                </table>
            </div>
            <p class="form-error" x-show="regError" x-text="regError"></p>
            <button class="btn btn-primary settings-save" @click="saveRegParams()" :disabled="savingKey === 'regParams'">규제 파라미터 저장</button>
        </div>

        <!-- 규제지역 (설계 I68) -->
        <div class="settings-section">
            <h4>규제지역</h4>
            <p class="settings-note">
                투기과열지구·조정대상지역은 국토부 고시로 지정·해제되며 <b>공개 API가 없습니다.</b>
                고시 번호를 근거에 남겨 두면 나중에 검증할 수 있습니다.
                등록이 없으면 전 매물이 비규제지역으로 계산됩니다.
            </p>
            <div class="card table-wrap">
                <table>
                    <thead>
                    <tr><th>법정동코드</th><th>구분</th><th>지역명</th><th>지정일</th><th>해제일</th><th>근거</th><th>상태</th><th></th></tr>
                    </thead>
                    <tbody>
                    <template x-if="regAreas.length === 0">
                        <tr><td colspan="8" class="empty-cell">등록된 규제지역이 없습니다 (전 매물 비규제 처리)</td></tr>
                    </template>
                    <template x-for="a in regAreas" :key="a.id">
                        <tr>
                            <td class="reg-key" x-text="a.codePrefix"></td>
                            <td><span class="badge b-off" x-text="a.zoneLabel"></span></td>
                            <td x-text="a.areaName || '-'"></td>
                            <td x-text="a.designatedOn || '-'"></td>
                            <td x-text="a.releasedOn || '-'"></td>
                            <td x-text="a.note || '-'"></td>
                            <td>
                                <span class="badge" :class="a.active ? 'b-on' : 'b-off'"
                                      x-text="a.active ? '유효' : '해제·대기'"></span>
                            </td>
                            <td>
                                <button class="btn btn-xs btn-danger" @click="deleteRegArea(a)" :disabled="loading">삭제</button>
                            </td>
                        </tr>
                    </template>
                    </tbody>
                </table>
            </div>
            <div class="form-grid reg-area-form">
                <label>법정동코드
                    <input type="text" x-model="regAreaForm.codePrefix" placeholder="11680 (시군구) 또는 1168010600 (법정동)">
                </label>
                <label>구분
                    <select x-model="regAreaForm.zone">
                        <option value="SPECULATION_OVERHEATED">투기과열지구</option>
                        <option value="ADJUSTMENT_TARGET">조정대상지역</option>
                    </select>
                </label>
                <label>지역명
                    <input type="text" x-model="regAreaForm.areaName" placeholder="서울 강남구">
                </label>
                <label>지정일
                    <input type="date" x-model="regAreaForm.designatedOn">
                </label>
                <label>해제일 (비우면 유효)
                    <input type="date" x-model="regAreaForm.releasedOn">
                </label>
                <label>근거
                    <input type="text" x-model="regAreaForm.note" placeholder="국토교통부 고시 제2026-000호">
                </label>
            </div>
            <button class="btn btn-primary" @click="addRegArea()" :disabled="loading || !regAreaForm.codePrefix.trim()">
                규제지역 추가
            </button>
        </div>

        <div class="settings-section">
            <h4>알림 이력</h4>
            <!-- 스위치가 환경변수에만 있어, 켜 두고도 등록 알림만 안 오는 이유를
                 화면에서 알 길이 없었다 (설계 I215). 읽기 전용이다 -->
            <template x-if="notifySettings">
                <div class="notify-state">
                    <span class="badge" :class="notifySettings.enabled ? 'b-on' : 'b-off'">
                        <span x-text="'알림 전체 ' + (notifySettings.enabled ? '켜짐' : '꺼짐')"></span>
                    </span>
                    <span class="badge" :class="notifySettings.notifyPropertyCreated ? 'b-on' : 'b-off'">
                        <span x-text="'매물 등록 알림 ' + (notifySettings.notifyPropertyCreated ? '켜짐' : '꺼짐')"></span>
                    </span>
                    <span class="badge" :class="notifySettings.baseUrlConfigured ? 'b-on' : 'b-off'">
                        <span x-text="notifySettings.baseUrlConfigured ? '링크 붙음' : '링크 없음'"></span>
                    </span>
                    <small>
                        환경변수로 정합니다 —
                        <code>SLACK_ENABLED</code> · <code>SLACK_NOTIFY_PROPERTY_CREATED</code> ·
                        <code>APP_BASE_URL</code>. 여기서는 <b>보기만</b> 합니다.
                    </small>
                </div>
            </template>
            <div class="card table-wrap">
                <table>
                    <thead><tr><th>이벤트</th><th>매물</th><th>상태</th><th>오류</th><th>시간</th></tr></thead>
                    <tbody>
                    <template x-if="notifications.length === 0">
                        <tr><td colspan="5" class="empty-cell">발송 이력이 없습니다</td></tr>
                    </template>
                    <template x-for="n in notifications" :key="n.id">
                        <tr>
                            <td x-text="n.eventType"></td>
                            <td class="num" x-text="n.propertyId ?? '-'"></td>
                            <td><span class="badge" :class="n.status==='SENT' ? 'b-on' : 'b-off'" x-text="n.status"></span></td>
                            <td x-text="n.errorMessage || ''"></td>
                            <td x-text="fmtTime(n.createdAt)"></td>
                        </tr>
                    </template>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- M2 매물 상세 모달 -->
<div class="modal modal-detail" x-show="showM2" x-cloak>
    <div class="modal-backdrop" @click="closeTopModal()"></div>
    <template x-if="detailItem">
        <div class="modal-card modal-xwide">
            <button class="modal-close" @click="closeDetail()">×</button>
            <div class="modal-head">
                <span class="modal-kicker">매물 상세</span>
                <h3 x-text="propertyTitle(detailItem.property)"></h3>
            </div>
            <!-- 응답이 늦으면 진행 막대를 띄운다 (설계 I115) -->
            <div class="progress-strip" x-show="isLoading('detail')" x-cloak>
                <span class="progress-strip-label">데이터 로딩 중입니다…</span>
                <div class="progress-strip-bar"><i></i></div>
            </div>
            <div class="m2-meta">
                <span class="badge" :class="dealBadge(detailItem.property.dealType)" x-text="dealLabel(detailItem.property.dealType)"></span>
                <span class="m2-price" x-text="fmtWon(detailItem.property.priceDeposit)"></span>
                <span class="score-pill" :class="detailItem.totalScore != null && detailItem.totalScore >= 50 ? 'score-high' : 'score-low'">
                    <b x-text="fmtScore(detailItem.totalScore)"></b><i>점</i>
                </span>
                <span class="owner-badge owner-badge-lg" x-show="detailItem.property.createdByNickname"
                      :title="'등록: ' + detailItem.property.createdByNickname">
                    <i class="owner-initial" x-text="ownerInitial(detailItem.property.createdByNickname)"></i>
                    <span x-text="detailItem.property.createdByNickname"></span>
                </span>
                <span class="group-badge" x-show="detailItem.property.groupName"
                      x-text="detailItem.property.groupName"></span>
            </div>

            <!-- 등록 직후에는 학교·규제·채점이 아직이다 (설계 I220) -->
            <div class="progress-strip" x-show="scoring(detailItem)" x-cloak>
                <span class="progress-strip-label">등록한 매물을 분석하고 있습니다… 잠시 뒤 저절로 채워집니다</span>
                <div class="progress-strip-bar"><i></i></div>
            </div>

            <div class="m2-grid">
                <section class="m2-sec">
                    <h4>기본</h4>
                    <div class="m2-rows">
                        <div class="m2-row"><span>주소</span><b x-text="detailItem.property.addressRoad || detailItem.property.addressJibun || '-'"></b></div>
                        <div class="m2-row"><span>공급면적</span><b x-text="fmtArea(detailItem.property.areaSupplyM2)"></b></div>
                        <div class="m2-row"><span>전용면적</span><b x-text="fmtArea(detailItem.property.areaExclusiveM2)"></b></div>
                        <div class="m2-row"><span>층/총층</span><b x-text="floorLabel(detailItem.property) || '-'"></b></div>
                        <div class="m2-row"><span>방/욕실</span><b x-text="detailItem.property.roomBath || '-'"></b></div>
                        <div class="m2-row"><span>향</span><b x-text="detailItem.property.direction || '-'"></b></div>
                        <div class="m2-row"><span>난방</span><b x-text="detailItem.property.heatingType || '-'"></b></div>
                        <div class="m2-row"><span>준공</span><b x-text="detailItem.property.approvalYear || '-'"></b></div>
                        <div class="m2-row"><span>세대수</span><b x-text="detailItem.property.totalHouseholds ? detailItem.property.totalHouseholds + '세대' : '-'"></b></div>
                        <div class="m2-row"><span>주차</span><b x-text="detailItem.property.parkingPerHousehold ? '세대당 ' + detailItem.property.parkingPerHousehold + '대' : '-'"></b></div>
                        <div class="m2-row"><span>상태</span><b x-text="detailItem.property.listingStatus"></b></div>
                    </div>
                </section>

                <section class="m2-sec">
                    <h4>비용</h4>
                    <div class="m2-rows">
                        <div class="m2-row"><span>관리비</span><b x-text="detailItem.property.maintenanceFee ? fmtWon(detailItem.property.maintenanceFee) + '/월' : '-'"></b></div>
                        <div class="m2-row"><span>KB시세</span><b x-text="detailItem.property.kbPrice ? fmtWon(detailItem.property.kbPrice) : '-'"></b></div>
                        <div class="m2-row"><span>공시가격</span><b x-text="detailItem.property.officialPrice ? fmtWon(detailItem.property.officialPrice) + (detailItem.property.officialPriceYear ? ' (' + detailItem.property.officialPriceYear + '년)' : '') : '조회 중 · 없음'"></b></div>
                        <div class="m2-row"><span>취득세</span><b x-text="detailItem.property.acquisitionTax ? fmtWon(detailItem.property.acquisitionTax) : '-'"></b></div>
                        <div class="m2-row"><span>재산세</span><b x-text="detailItem.property.propertyTax ? fmtWon(detailItem.property.propertyTax) : '-'"></b></div>
                        <div class="m2-row"><span>종부세</span><b x-text="detailItem.property.comprehensiveTax || '-'"></b></div>
                        <div class="m2-row"><span>중개보수</span><b x-text="detailItem.property.brokerageFee ? '최대 ' + fmtWon(detailItem.property.brokerageFee) : '-'"></b></div>
                        <div class="m2-row"><span>상한요율</span><b x-text="detailItem.property.brokerageRate ? detailItem.property.brokerageRate + '%' : '-'"></b></div>
                    </div>
                </section>

                <section class="m2-sec">
                    <h4>입지</h4>
                    <div class="m2-rows">
                        <div class="m2-row">
                            <span>배정 초등학교</span>
                            <b>
                                <span x-text="detailItem.property.schoolName || '-'"></span>
                                <small x-show="detailItem.property.schoolWalkMinutes" x-text="' 도보 ' + detailItem.property.schoolWalkMinutes + '분'"></small>
                                <small class="m2-src" x-show="detailItem.property.schoolSource === 'KAKAO'">카카오 보정</small>
                            </b>
                        </div>
                        <div class="m2-row"><span>입주</span><b x-text="moveInLabel(detailItem.property)"></b></div>
                        <div class="m2-row"><span>매물번호</span><b x-text="detailItem.property.naverArticleNo || '-'"></b></div>
                        <!-- 공시가격·토지이용계획 조회 키. 값이 비면 그 둘이 왜 안 뜨는지 바로 알 수 있다 -->
                        <div class="m2-row">
                            <span>PNU</span>
                            <b class="m2-mono" x-text="detailItem.property.pnu || '-'"></b>
                        </div>
                    </div>
                </section>

                <section class="m2-sec">
                    <h4>중개사</h4>
                    <template x-if="detailAgents.length === 0">
                        <p class="m2-empty">등록된 중개사 정보가 없습니다.</p>
                    </template>
                    <template x-for="a in detailAgents" :key="a.agentId">
                        <div class="m2-rows">
                            <div class="m2-row"><span>중개사무소</span><b x-text="a.officeName || '-'"></b></div>
                            <div class="m2-row"><span>중개인</span><b x-text="a.agentName || '-'"></b></div>
                            <div class="m2-row"><span>전화</span><b x-text="a.phone || '-'"></b></div>
                            <div class="m2-row"><span>휴대폰</span><b x-text="a.mobile || '-'"></b></div>
                        </div>
                    </template>
                </section>

                <!-- 순서는 읽는 순서다 (설계 I208): 기본 → 비용 → 입지 → 중개사 → 평면도 → 사진.
                     사진이 없으면 <b>칸 자체를 안 그린다</b> — "없습니다" 한 줄이 격자에
                     빈자리를 만들어 뒤 칸을 밀어낸다 -->
                <template x-if="detailFloorPlan">
                    <section class="m2-sec">
                        <h4>평면도</h4>
                        <button class="m2-figure" @click="openPhotoViewer(detailImages.indexOf(detailFloorPlan), detailImages)"
                                title="크게 보기">
                            <img :src="detailFloorPlan.storagePath" alt="평면도">
                        </button>
                    </section>
                </template>

                <template x-if="detailPhotos.length > 0">
                    <section class="m2-sec m2-sec-wide">
                        <h4>사진 <span class="m2-count" x-text="detailPhotos.length + '장'"></span></h4>
                        <!-- 끌어서 넘긴다 (설계 I214). 조금이라도 끌었으면 클릭이 아니다 -->
                        <div class="m2-photos" @pointerdown.prevent="startPhotoDrag($event)">
                            <template x-for="img in detailPhotos" :key="img.id">
                                <button class="m2-figure" @click="openPhotoViewer(detailImages.indexOf(img), detailImages)"
                                        title="크게 보기 (좌우 방향키로 넘김)">
                                    <img :src="img.storagePath" alt="매물사진">
                                </button>
                            </template>
                        </div>
                    </section>
                </template>

                <section class="m2-sec m2-sec-wide">
                    <h4>토지이용계획</h4>
                    <template x-if="detailLandUse.length === 0">
                        <p class="m2-empty">조회된 토지이용계획이 없습니다.
                            <button class="btn btn-xs" @click="refreshLandUse()" :disabled="loading">지금 조회</button>
                        </p>
                    </template>
                    <template x-if="detailLandUse.length > 0">
                        <div>
                            <div class="lu-notable" x-show="notableLandUse().length > 0">
                                <template x-for="l in notableLandUse()" :key="l.zoneName">
                                    <span class="lu-badge" x-text="l.zoneName"></span>
                                </template>
                                <small>매수 조건에 영향을 주는 항목입니다</small>
                            </div>
                            <div class="lu-groups">
                                <template x-for="g in landUseGroups()" :key="g.key">
                                    <div class="lu-group">
                                        <span class="lu-group-label" x-text="g.label"></span>
                                        <span class="lu-names" x-text="g.names.join(' · ')"></span>
                                    </div>
                                </template>
                            </div>
                            <p class="m2-empty lu-note">
                                <b>포함</b>만 이 필지에 실제로 적용됩니다. 저촉은 일부만 걸치고, 접함은 인접할 뿐입니다.
                                <button class="btn btn-xs" @click="refreshLandUse()" :disabled="loading">다시 조회</button>
                            </p>
                        </div>
                    </template>
                </section>

                <section class="m2-sec m2-sec-wide">
                    <h4>AI 추천도</h4>
                    <!-- 처음 분석이 도는 중이면 진행 표시 (설계 I72) -->
                    <template x-if="!detailLlm && llmPending">
                        <div class="progress-strip">
                            <span class="progress-strip-label">AI가 데이터를 분석 중입니다…</span>
                            <div class="progress-strip-bar"><i></i></div>
                        </div>
                    </template>
                    <!-- 재질의는 쾌적함·코멘트가 바뀔 때 백엔드에서 트리거된다 (설계 I78) -->
                    <template x-if="!detailLlm && !llmPending">
                        <p class="m2-empty">아직 산출되지 않았습니다.</p>
                    </template>
                    <template x-if="detailLlm">
                        <div class="llm-box">
                            <div class="llm-score">
                                <b x-text="fmtScore(detailLlm.score)"></b><i>점</i>
                            </div>
                            <div class="llm-body">
                                <p x-text="detailLlm.reason"></p>
                                <div class="llm-meta">
                                    <span x-text="detailLlm.model"></span>
                                    <span x-text="fmtTime(detailLlm.computedAt)"></span>
                                </div>
                            </div>
                        </div>
                    </template>
                </section>

                <section class="m2-sec m2-sec-wide">
                    <h4>국토교통부 실거래가</h4>
                    <!-- 얼마나 찾아본 것인지 말해 준다 (설계 I98). '없습니다'만 뜨면
                         조회를 못 한 것인지 정말 거래가 없는 것인지 알 수 없다 -->
                    <!-- 받아 오는 중이면 <b>없다고 단정하지 않는다</b> (설계 I259).
                         화면은 기다리지 않고 배경에서 받아 오는데(I106), 그동안
                         "거래내역이 없습니다"를 띄우고 있었다 -->
                    <template x-if="detailRef?.looking">
                        <div class="progress-strip">
                            <span class="progress-strip-label">국토부 실거래를 받아 오는 중입니다…</span>
                            <div class="progress-strip-bar"><i></i></div>
                        </div>
                    </template>
                    <!-- 기다리다 지친 것과 <b>정말 없는 것</b>은 다르다 (설계 I262).
                         둘을 같은 문장으로 말하면 "없습니다"가 거짓이 된다 -->
                    <template x-if="detailRef?.timedOut && detailRef.transactions.length === 0">
                        <p class="m2-empty">
                            아직 받아 오는 중입니다. 잠시 뒤 다시 열어 주십시오.
                            <button type="button" class="link-btn"
                                    @click="reloadReferences(detailItem.property.id)">지금 다시 확인</button>
                        </p>
                    </template>
                    <template x-if="!detailRef?.looking && !detailRef?.timedOut
                                    && (!detailRef || detailRef.transactions.length === 0)">
                        <p class="m2-empty">
                            <span x-show="detailRef"
                                  x-text="'최근 ' + detailRef?.lookbackMonths + '개월 동안 같은 단지·면적의 거래내역이 없습니다.'"></span>
                            <span x-show="!detailRef">조회된 실거래가가 없습니다.</span>
                        </p>
                    </template>
                    <template x-if="detailRef && detailRef.transactions.length > 0">
                        <div>
                            <p class="m2-gap" x-show="detailRef.gapPercent != null"
                               x-text="'최근 실거래 대비 호가 ' + (detailRef.gapPercent > 0 ? '+' : '') + detailRef.gapPercent + '%'"></p>
                            <div class="table-wrap">
                                <table>
                                    <thead><tr><th>계약일</th><th>층</th><th>거래가</th></tr></thead>
                                    <tbody>
                                    <template x-for="(tx, i) in detailRef.transactions.slice(0, 8)" :key="i">
                                        <tr>
                                            <td x-text="tx.contractDate || '-'"></td>
                                            <td x-text="tx.floorNo != null ? tx.floorNo + '층' : '-'"></td>
                                            <td class="strong" x-text="fmtWon(tx.price)"></td>
                                        </tr>
                                    </template>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </template>
                </section>
            </div>

            <!-- 원본 매물 페이지. 상세를 다 읽고 마지막에 직접 확인하러 가는 자리라 하단에 둔다 -->
            <template x-if="detailItem.property.sourceUrl">
                <a class="m2-source" :href="detailItem.property.sourceUrl"
                   :title="detailItem.property.sourceUrl"
                   target="_blank" rel="noopener noreferrer">
                    <span class="m2-source-label">원본 매물 보기</span>
                    <span class="m2-source-url" x-text="detailItem.property.sourceUrl"></span>
                </a>
            </template>

            <div class="m2-actions">
                <button class="btn btn-sm" @click="openScoreModal(detailItem)">채점</button>
                <button class="btn btn-sm" @click="openLoanModal(detailItem)">대출</button>
                <button class="btn btn-sm" @click="openComments(detailItem)">코멘트</button>
                <button class="btn btn-sm" @click="openPhotoModal(detailItem)">사진</button>
                <button class="btn btn-sm btn-primary" @click="openEditProperty(detailItem)">정보 수정</button>
            </div>
        </div>
    </template>
</div>

<!-- D10 매물 수기 등록/수정 모달 -->
<div class="modal" x-show="showPropertyForm" x-cloak>
    <div class="modal-backdrop" @click="closeTopModal()"></div>
    <div class="modal-card modal-wide">
        <div class="modal-head">
            <span class="modal-kicker">매물 등록</span>
            <h3 x-text="propertyForm.id ? '매물 수정' : '매물 수기 등록'"></h3>
            <p>네이버 붙여넣기 등록은 추후 제공됩니다. 지금은 핵심 정보를 직접 입력하세요.</p>
        </div>
        <form class="form" @submit.prevent="saveProperty()">
            <div class="form-grid">
                <label class="span2">매물명
                    <input type="text" x-model="propertyForm.name" placeholder="예: 한빛아파트" required>
                </label>
                <!-- 같은 단지 매물이 여럿이면 <b>동·호가 유일한 구분</b>이다 (설계 I269).
                     지도 좌표도 이 값으로 갈린다 (설계 I268) -->
                <label class="span2">동/호
                    <input type="text" x-model="propertyForm.dongHo" placeholder="예: 102동 1503호">
                </label>
                <label>거래유형
                    <select x-model="propertyForm.dealType">
                        <option value="SALE">매매</option>
                        <option value="JEONSE">전세</option>
                    </select>
                </label>
                <!-- 금액은 type=text + 숫자만 (설계 I160). number 는 화살표가 붙고 휠로 값이
                     바뀌며, 자릿수 많은 원 단위에서 실수를 부른다 -->
                <label>보증금/매매가 (원)
                    <span class="money-row">
                        <input type="text" inputmode="numeric" style="width:50%"
                               :value="propertyForm.priceDeposit"
                               @input="propertyForm.priceDeposit = numericInput($event)"
                               placeholder="550000000">
                        <span class="money-hint" x-show="moneyHint(propertyForm.priceDeposit)"
                              x-text="moneyHint(propertyForm.priceDeposit)"></span>
                    </span>
                </label>
                <label>관리비 (원/월)
                    <span class="money-row">
                        <input type="text" inputmode="numeric" style="width:50%"
                               :value="propertyForm.maintenanceFee"
                               @input="propertyForm.maintenanceFee = numericInput($event)"
                               placeholder="0">
                        <span class="money-hint" x-show="moneyHint(propertyForm.maintenanceFee)"
                              x-text="moneyHint(propertyForm.maintenanceFee)"></span>
                    </span>
                </label>
                <!-- KB시세는 대출 한도(LTV)를 가르는 값이다 (설계 I160). 파싱이 놓치거나
                     은행이 다르게 볼 때 사람이 고칠 수 있어야 한다 -->
                <label>KB시세 (원)
                    <span class="money-row">
                        <input type="text" inputmode="numeric" style="width:50%"
                               :value="propertyForm.kbPrice"
                               @input="propertyForm.kbPrice = numericInput($event)"
                               placeholder="740000000">
                        <span class="money-hint" x-show="moneyHint(propertyForm.kbPrice)"
                              x-text="moneyHint(propertyForm.kbPrice)"></span>
                    </span>
                    <span class="settings-note">은행이 LTV를 매길 때 보는 값입니다. 비우면 실거래·공시가격으로 대신합니다.</span>
                </label>
                <label class="span2">주소로 좌표 검색
                    <div class="workplace-search">
                        <input type="text" x-model="propertyQuery" placeholder="예: 서울 노원구 상계동 692" @keyup.enter.prevent="searchPropertyAddress()">
                        <button class="btn" type="button" @click="searchPropertyAddress()">검색</button>
                    </div>
                </label>
                <p class="form-error span2" x-show="propertyAddrError" x-text="propertyAddrError"></p>
                <template x-if="propertyAddrResults.length > 0">
                    <div class="workplace-results span2">
                        <template x-for="(r, i) in propertyAddrResults" :key="i">
                            <button class="workplace-result" type="button" @click="selectPropertyAddress(r)">
                                <span x-text="r.addressName"></span>
                                <small x-text="r.roadAddressName"></small>
                            </button>
                        </template>
                    </div>
                </template>
                <label class="span2">도로명주소
                    <input type="text" x-model="propertyForm.addressRoad" placeholder="서울시 ...">
                </label>
                <label class="span2">원본 URL
                    <input type="url" x-model="propertyForm.sourceUrl" placeholder="https://fin.land.naver.com/articles/...">
                    <span class="settings-note">넣어 두면 판매완료를 자동으로 감지합니다.</span>
                </label>
                <label>위도
                    <input type="number" step="0.000001" readonly x-model="propertyForm.lat" placeholder="주소 검색 시 자동 입력">
                </label>
                <label>경도
                    <input type="number" step="0.000001" readonly x-model="propertyForm.lng" placeholder="주소 검색 시 자동 입력">
                </label>
                <label>전용면적 (㎡)
                    <input type="number" step="0.01" min="0" x-model="propertyForm.areaExclusiveM2" placeholder="84.9">
                </label>
                <label>공급면적 (㎡)
                    <input type="number" step="0.01" min="0" x-model="propertyForm.areaSupplyM2" placeholder="112.0">
                </label>
                <!-- 층은 숫자만이 아니다 (설계 I286). 네이버가 저층을 감추면 `저/15층`
                     처럼 밴드로 온다 — number 칸이면 그 값을 아예 못 적는다 -->
                <label>층
                    <input type="text" inputmode="text" maxlength="2"
                           x-model="propertyForm.floorRaw"
                           @input="propertyForm.floorRaw = floorInput($event)"
                           placeholder="5 또는 저/중/고">
                </label>
                <label>총 층수
                    <input type="number" min="1" x-model="propertyForm.floorTotal" placeholder="12">
                </label>
                <label>향
                    <input type="text" x-model="propertyForm.direction" placeholder="남향">
                </label>
                <label>준공년도
                    <input type="number" min="1900" x-model="propertyForm.approvalYear" placeholder="2018">
                </label>
                <label>건물동수
                    <input type="number" min="1" x-model="propertyForm.buildingCount" placeholder="3">
                </label>
                <label>총세대수
                    <input type="number" min="1" x-model="propertyForm.totalHouseholds" placeholder="300">
                </label>
                <label>세대당 주차 (대)
                    <input type="number" min="0" step="0.01" x-model="propertyForm.parkingPerHousehold"
                           placeholder="1.2">
                </label>
                <label>입주가능
                    <select x-model="propertyForm.moveInType">
                        <option value="">선택 안 함</option>
                        <option value="IMMEDIATE">즉시 입주</option>
                        <option value="NEGOTIABLE">협의</option>
                        <option value="DATE">날짜 지정</option>
                    </select>
                </label>
                <label>입주가능일
                    <input type="date" x-model="propertyForm.moveInDate">
                </label>
            </div>
            <p class="form-error" x-show="error" x-text="error"></p>
            <!-- 등록은 초등학교·토지이용계획·채점이 끝나야 응답이 온다 (설계 I110).
                 몇 초 걸리므로 무엇을 기다리는지 말해 준다 -->
            <div class="progress-strip" x-show="loading">
                <span class="progress-strip-label"
                      x-text="propertyForm.id ? '저장 중입니다…'
                              : '저장 중입니다… 학교·규제·점수를 확인하고 있습니다'"></span>
                <div class="progress-strip-bar"><i></i></div>
            </div>
            <button class="btn btn-primary btn-block" type="submit" :disabled="loading">
                <span x-text="loading ? '저장 중…' : (propertyForm.id ? '저장' : '등록')"></span>
            </button>
        </form>
    </div>
</div>

<!-- D14 평가 채점 모달 -->
<div class="modal" x-show="showScoreModal" x-cloak>
    <div class="modal-backdrop" @click="closeTopModal()"></div>
    <div class="modal-card modal-xwide">
        <button class="modal-close" @click="closeScoreModal()">×</button>
        <div class="modal-head">
            <span class="modal-kicker">평가 채점</span>
            <h3 x-text="propertyTitle(scoreProperty?.property)"></h3>
            <p>자동으로 계산되지 않은 항목은 직접 점수를 넣을 수 있습니다. 입력한 값은 자동 점수보다 우선합니다.</p>
        </div>
        <!-- 응답이 늦으면 진행 막대를 띄운다 (설계 I115) -->
        <div class="progress-strip" x-show="isLoading('score')" x-cloak>
            <span class="progress-strip-label">데이터 로딩 중입니다…</span>
            <div class="progress-strip-bar"><i></i></div>
        </div>

        <div class="score-summary">
            <div class="score-summary-total">
                <span>총점</span>
                <b x-text="fmtScore(scoreProperty?.totalScore)"></b>
            </div>
            <div class="score-summary-counts">
                <span><i class="dot dot-auto"></i>자동 <b x-text="scoreCount('AUTO')"></b></span>
                <span><i class="dot dot-manual"></i>수동 <b x-text="scoreCount('MANUAL')"></b></span>
                <span><i class="dot dot-fallback"></i>미산출 <b x-text="scoreCount('FALLBACK')"></b></span>
            </div>
        </div>

        <!-- 등록 직후에는 채점이 아직이다 (설계 I220) -->
        <div class="progress-strip" x-show="scoring(scoreProperty)" x-cloak>
            <span class="progress-strip-label">채점하고 있습니다… 학교·규제·직주근접을 확인하는 중입니다</span>
            <div class="progress-strip-bar"><i></i></div>
        </div>
        <div class="score-list">
            <template x-for="s in (scoreProperty?.scores || [])" :key="s.code">
                <div class="score-item" :class="{'is-fallback': s.scoreSource==='FALLBACK'}">
                    <div class="score-item-head">
                        <span class="score-item-name" x-text="s.name"></span>
                        <span class="badge" :class="scoreSourceBadge(s.scoreSource)" x-text="scoreSourceLabel(s.scoreSource)"></span>
                        <span class="badge b-jeonse" x-show="s.scoringType==='HYBRID' && s.scoreSource==='AUTO'">추정</span>
                    </div>

                    <!-- 잠긴 항목은 <b>읽기용 막대</b>, 열린 항목은 <b>끌어서 매기는 슬라이더</b>
                         (설계 I172). 같은 자리에 같은 모양으로 두어 눈이 옮겨 다니지 않는다 -->
                    <div class="score-item-gauge" x-show="scoreLocked(s)">
                        <div class="gauge-track">
                            <div class="gauge-fill" :class="s.scoreSource==='MANUAL' ? 'is-manual' : ''"
                                 :style="'width:' + (s.effectiveScore == null ? 0 : s.effectiveScore) + '%'"></div>
                        </div>
                        <span class="gauge-value" x-text="fmtScore(s.effectiveScore)"></span>
                    </div>

                    <!-- 이미 자동 채점된 AUTO 항목은 잠근다 (설계 I111). 열어 두면
                         추정값으로 채워진 칸이 그대로 저장돼 자동 채점이 수동으로 굳는다 -->
                    <div class="score-item-slider" x-show="!scoreLocked(s)">
                        <!-- 지나온 쪽만 색을 채운다 (설계 I200). 손잡이 위치만으로는
                             1점인지 5점인지 눈에 안 들어온다 -->
                        <input type="range" class="score-range"
                               :min="scoreMin(s)" :max="scoreMax(s)" :step="scoreStep(s)"
                               :value="scoreSliderValue(s)"
                               :style="scoreRangeFill(s)"
                               @input="scoreForm[s.code] = $event.target.value"
                               :aria-label="s.name + ' 점수'"
                               :aria-valuetext="scoreSliderValue(s) + '점'">
                        <!-- 손잡이가 가리키는 값을 그대로 보여 준다 (설계 I287).
                             빈 칸이면 손잡이는 가운데 있는데 숫자만 '–' 라, 저장해도
                             아무 일이 없는 이유를 화면에서 알 수 없었다 -->
                        <span class="gauge-value" x-text="scoreSliderValue(s)"></span>
                    </div>

                    <p class="score-item-reason" x-show="s.fallbackReason">
                        <span x-text="s.fallbackReason"></span>
                        <!-- 미산출은 대개 그때 조회가 실패한 것이다. 다시 눌러 볼 수 있게 한다 (설계 I119).
                             이미 점수가 있으면 버튼은 안 보인다 -->
                        <button class="btn btn-xs" type="button"
                                x-show="s.effectiveScore == null"
                                :disabled="isLoading('recompute')"
                                @click="recomputeScores()">재산출</button>
                    </p>
                    <p class="score-item-why" x-show="s.explanation && s.scoreSource === 'AUTO'" x-text="s.explanation"></p>
                    <!-- 남이 매겼는지가 아니라 '내가' 매겼는지로 가른다 (설계 I118) -->
                    <p class="score-item-invite" x-show="s.code === 'COMFORT' && s.myScore == null">
                        방문하셨나요? 공간은 어땠습니까? 점수로 매겨주세요.
                    </p>
                    <p class="score-item-mine" x-show="s.code === 'COMFORT' && s.myScore != null">
                        내가 매긴 점수 <b x-text="s.myScore + '점'"></b>
                    </p>
                    <!-- 총점에는 사용자들의 평균이 들어간다. 내 점수만 보이면 왜 그 총점인지 알 수 없다 -->
                    <p class="score-item-others" x-show="s.othersAverage != null">
                        다른 사용자들은 평균 <b x-text="s.othersAverage"></b>점으로 평가했습니다.
                        <span class="score-item-others-n" x-text="'(' + s.othersCount + '명)'"></span>
                    </p>
                </div>
            </template>
        </div>

        <p class="form-error" x-show="error" x-text="error"></p>
        <div class="score-actions">
            <span class="score-hint">쾌적함은 사용자별 1~5로 평가해 평균 × 20으로 환산됩니다.</span>
            <button class="btn" @click="closeScoreModal()">닫기</button>
            <button class="btn btn-primary" @click="saveScore()" :disabled="loading">
                <span x-text="loading ? '저장 중…' : '채점 저장'"></span>
            </button>
        </div>
    </div>
</div>

<!-- D16-2 국토부 실거래가 참고 카드 모달 -->
<div class="modal" x-show="showRefModal" x-cloak>
    <div class="modal-backdrop" @click="closeTopModal()"></div>
    <div class="modal-card modal-wide">
        <div class="modal-head">
            <span class="modal-kicker">최근 실거래</span>
            <h3 x-text="propertyTitle(refProperty?.property)"></h3>
            <p>국토부 실거래가 참고용입니다. 채점에는 반영되지 않습니다.</p>
        </div>
        <div class="form-grid">
            <!-- 빈 칸이면 지번주소에서 뽑아 씁니다. 무엇으로 물었는지 아래에 적습니다 (설계 I227) -->
            <label>법정동코드 (5자리)
                <input type="text" x-model="refForm.legalDongCode"
                       :placeholder="refCard?.lawdCd || '주소에서 자동'" maxlength="5">
                <span class="paste-note" x-show="refCard">
                    <template x-if="refCard?.lawdCd">
                        <span>이번 조회에 쓴 코드: <b x-text="refCard.lawdCd"></b>
                            — 국토부는 <b>시군구 5자리</b>를 받습니다
                            (법정동 10자리 <code>1135010500</code> 의 앞 다섯 자리)</span>
                    </template>
                    <template x-if="!refCard?.lawdCd">
                        <span class="ref-nocode">지번주소에서 법정동코드를 못 찾았습니다 —
                            <b>그래서 조회 자체가 안 됩니다.</b> 직접 넣어 보십시오</span>
                    </template>
                </span>
            </label>
            <label>계약년월 (YYYYMM)
                <input type="text" x-model="refForm.dealMonth" placeholder="202607" maxlength="6">
            </label>
        </div>
        <div class="paste-actions">
            <button class="btn btn-primary" @click="loadReference()" :disabled="loading">조회</button>
        </div>
        <p class="form-error" x-show="error" x-text="error"></p>
        <template x-if="refCard">
            <div class="ref-card">
                <!-- 비었으면 <b>어느 단계에서 걸렸는지</b> 말한다 (설계 I232).
                     "없습니다" 한 줄로는 코드 문제인지 이름 문제인지 면적 문제인지 알 수 없었다 -->
                <template x-if="refCard.looking">
                    <div class="progress-strip">
                        <span class="progress-strip-label">국토부 실거래를 받아 오는 중입니다…</span>
                        <div class="progress-strip-bar"><i></i></div>
                    </div>
                </template>
                <template x-if="!refCard.looking && refCard.transactions.length === 0">
                    <p class="ref-empty" x-text="refEmptyReason()"></p>
                </template>
                <!-- 면적을 함께 보여 준다 (설계 I232). 없으면 "우리 집과 같은 평형인지"
                     알 수 없다 — 실제로 전용면적에 공급면적이 들어간 것을 못 알아챘다 -->
                <p class="ref-other-area" x-show="refCard.areaMismatch">
                    전용 <b x-text="fmtArea(refProperty?.property?.areaExclusiveM2)"></b> 와 맞는 거래가 없어
                    <b>같은 단지의 다른 평형</b>을 보여 줍니다. 호가 대비 괴리는 내지 않습니다 —
                    평형이 다르면 견줄 수 없습니다.
                </p>
                <template x-for="t in refCard.transactions" :key="t.contractDate + '-' + t.floorNo + '-' + t.areaM2">
                    <div class="ref-row">
                        <span x-text="t.contractDate"></span>
                        <b x-text="fmtWon(t.price)"></b>
                        <span x-text="t.areaM2 ? fmtArea(t.areaM2) : ''"></span>
                        <span x-text="t.floorNo ? t.floorNo + '층' : ''"></span>
                    </div>
                </template>
                <p class="ref-gap" x-show="refCard.gapPercent != null">
                    호가 <b x-text="fmtWon(refCard.askingPrice)"></b> vs 최근 실거래 → 괴리 <b x-text="(refCard.gapPercent > 0 ? '+' : '') + refCard.gapPercent + '%'"></b>
                </p>
            </div>
        </template>
    </div>
</div>

<!-- D16 대출 한도 시뮬레이션 모달 -->
<div class="modal" x-show="showLoanModal" x-cloak>
    <div class="modal-backdrop" @click="closeTopModal()"></div>
    <div class="modal-card modal-wide loan-modal">
        <button class="modal-close" @click="closeLoanModal()">×</button>
        <div class="modal-head">
            <span class="modal-kicker">대출 한도</span>
            <h3 x-text="propertyTitle(loanProperty?.property)"></h3>
            <p>내 프로필의 연소득·보유 현금으로 바로 계산했습니다. 자체 추정이며 실제 한도는 은행 가심사가 필요합니다.</p>
        </div>
        <!-- 응답이 늦으면 진행 막대를 띄운다 (설계 I115) -->
        <div class="progress-strip" x-show="isLoading('loan')" x-cloak>
            <span class="progress-strip-label">데이터 로딩 중입니다…</span>
            <div class="progress-strip-bar"><i></i></div>
        </div>

        <template x-if="loanResult">
            <div>
                <!-- 한도 요약 -->
                <div class="loan-hero">
                    <div class="loan-hero-main">
                        <span class="loan-hero-label" x-text="loanResult.productLabel + ' 최종 한도'"></span>
                        <strong x-text="fmtWon(loanResult.finalLimit)"></strong>
                        <small x-text="loanBindingLabel()"></small>
                    </div>
                    <div class="loan-hero-side">
                        <div x-show="loanResult.productType === 'MORTGAGE'">
                            <span>LTV 한도</span><b x-text="fmtWon(loanResult.ltvLimit)"></b>
                        </div>
                        <div x-show="loanResult.productType === 'JEONSE'">
                            <span>보증 한도</span><b x-text="fmtWon(loanResult.guaranteeLimit)"></b>
                        </div>
                        <div><span>DSR 한도</span><b x-text="fmtWon(loanResult.dsrLimit)"></b></div>
                    </div>
                </div>

                <!-- 어떤 규정으로 이 LTV가 나왔는지 (설계 I66) — 매매 전용 -->
                <div class="loan-policy" x-show="loanResult.productType === 'MORTGAGE'">
                    <span class="badge" :class="loanResult.zone === 'NORMAL' ? 'b-mem' : 'b-off'"
                          x-text="loanResult.zoneLabel"></span>
                    <span class="badge b-mem" x-text="loanResult.ownershipLabel"></span>
                    <span class="loan-policy-reason" x-text="loanResult.ltvReason"></span>
                </div>

                <!-- 담보가치 — LTV의 기준. 호가와 다르고 출처마다 신뢰도가 다르다 (설계 I64·I65) -->
                <div class="loan-collateral" x-show="loanResult.productType === 'MORTGAGE'"
                     :class="loanResult.collateralReliable ? '' : 'weak'">
                    <div class="loan-collateral-main">
                        <span>담보가치 (LTV 기준)</span>
                        <b x-text="fmtWon(loanResult.collateralValue)"></b>
                    </div>
                    <div class="loan-collateral-src">
                        <span class="badge" :class="loanResult.collateralReliable ? 'b-on' : 'b-off'"
                              x-text="loanResult.collateralSourceLabel"></span>
                        <small x-show="loanResult.collateralSource === 'RECENT_TRADE'"
                               x-text="'실거래 ' + loanResult.collateralSampleCount + '건 · 단가 환산'"></small>
                        <small x-show="loanResult.collateralSource === 'ASKING_PRICE'">
                            KB시세·실거래·공시가격이 없어 호가로 계산했습니다
                        </small>
                        <small x-show="loanResult.leaseDeduction > 0"
                               title="소액 세입자가 은행보다 먼저 변제받는 몫. MCI/MCG에 가입하면 빠지지 않습니다"
                               x-text="'방공제 −' + fmtWon(loanResult.leaseDeduction) + ' (소액임차보증금)'"></small>
                    </div>
                </div>

                <!-- 전세 전용 — 담보가 집이 아니라 보증기관의 보증이다 (설계 I67) -->
                <div class="loan-collateral" x-show="loanResult.productType === 'JEONSE'">
                    <div class="loan-collateral-main">
                        <span>보증 기준</span>
                        <b x-text="fmtWon(loanResult.guaranteeLimit)"></b>
                    </div>
                    <div class="loan-collateral-src">
                        <span class="badge b-mem"
                              x-text="'보증비율 ' + (loanResult.guaranteeRate * 100) + '%'"></span>
                        <small x-text="'보증기관 한도 ' + fmtWon(loanResult.guaranteeCap)"></small>
                        <small>담보는 집이 아니라 보증기관의 보증입니다 — 취득세·방공제가 없습니다</small>
                    </div>
                </div>

                <!-- 매매가 대비 구성 -->
                <div class="loan-stack">
                    <div class="loan-stack-bar">
                        <span class="seg seg-loan" :style="`width:${loanPercent(loanAmount, loanResult.askingPrice)}%`"></span>
                        <span class="seg seg-cash" :style="`width:${loanPercent(loanOwnCapital(), loanResult.askingPrice)}%`"></span>
                    </div>
                    <div class="loan-stack-legend">
                        <span><i class="dot dot-loan"></i>대출 <b x-text="fmtWon(loanAmount)"></b></span>
                        <span><i class="dot dot-cash"></i>자기자본 <b x-text="fmtWon(loanOwnCapital())"></b></span>
                        <span class="loan-stack-total">
                            <span x-text="loanResult.productType === 'JEONSE' ? '보증금' : '매매가'"></span>
                            <b x-text="fmtWon(loanResult.askingPrice)"></b>
                        </span>
                    </div>
                </div>

                <!-- 대출액 조정 -->
                <div class="loan-slider">
                    <div class="loan-slider-head">
                        <label for="loanAmountRange">대출 희망액</label>
                        <output x-text="fmtWon(loanAmount)"></output>
                    </div>
                    <input id="loanAmountRange" type="range" min="0" :max="loanResult.finalLimit"
                           step="1000000" x-model.number="loanAmount">
                    <div class="loan-slider-scale">
                        <span>0</span>
                        <span x-text="'한도 ' + fmtWon(loanResult.finalLimit)"></span>
                    </div>
                </div>

                <!-- 조정 결과 -->
                <div class="loan-cards">
                    <div class="loan-card">
                        <span>월 상환액</span>
                        <b x-text="fmtWon(loanMonthlyAt(loanAmount))"></b>
                        <small x-text="loanResult.interestOnly
                            ? `${loanResult.termMonths / 12}년 만기일시 · 이자만`
                            : `${loanResult.termMonths / 12}년 원리금균등`"></small>
                        <!-- 어디서 온 금리인지 안 보이면 사용자는 검증할 수 없다 (설계 I81) -->
                        <small class="loan-rate-source" x-show="loanResult.rateSource"
                               x-text="fmtRate(loanResult.monthlyRate) + ' · ' + loanResult.rateSource"></small>
                        <!-- 한도는 스트레스 금리로 역산한다. 실제로 내는 돈과 다르다 (설계 I97) -->
                        <small class="loan-rate-source" x-show="loanResult.dsrRate">
                            한도 산정은 <b x-text="(loanResult.dsrRate * 100).toFixed(2) + '%'"></b>
                            (스트레스 DSR · <span x-text="loanResult.rateTypeLabel"></span>)
                        </small>
                        <!-- 스트레스 금리도 어디서 왔는지 밝힌다 (설계 I116).
                             한도를 좁히는 숫자라 출처가 없으면 검증할 수 없다 -->
                        <small class="loan-rate-source" x-show="loanResult.stressRateSource"
                               x-text="loanResult.stressRateSource"></small>
                    </div>
                    <div class="loan-card">
                        <span>필요 자기자본</span>
                        <b x-text="fmtWon(loanOwnCapital())"></b>
                        <small x-text="loanResult.productType === 'JEONSE' ? '보증금 − 대출' : '매매가 − 대출'"></small>
                    </div>
                    <div class="loan-card" x-show="loanResult.productType === 'MORTGAGE'">
                        <span>취득세</span>
                        <b x-text="fmtWon(loanResult.acquisitionTax)"></b>
                        <small x-text="loanForm.firstHome ? '생애최초 감면 반영' : '일반 세율'"></small>
                    </div>
                    <div class="loan-card" :class="loanCashGap() >= 0 ? 'loan-ok' : 'loan-short'">
                        <span x-text="loanCashGap() >= 0 ? '현금 여유' : '현금 부족'"></span>
                        <b x-text="fmtWon(Math.abs(loanCashGap()))"></b>
                        <small x-text="'보유 현금 ' + fmtWon(loanResult.usedCash)
                               + (loanResult.groupCash != null && loanResult.groupCash !== loanResult.usedCash
                                  ? ' · 그룹 합산 ' + fmtWon(loanResult.groupCash) : '')"></small>
                    </div>
                </div>

                <!-- 계산 전제 -->
                <div class="loan-assume">
                    <label class="loan-check" x-show="loanResult.productType === 'MORTGAGE'">
                        <input type="checkbox" x-model="loanForm.firstHome" @change="runLoanEstimate()">
                        <span>생애최초</span>
                    </label>
                    <label class="loan-check" x-show="loanResult.productType === 'MORTGAGE'">
                        <input type="checkbox" x-model="loanForm.mortgageInsured" @change="runLoanEstimate()">
                        <span>MCI/MCG 가입</span>
                        <!-- 5,500만원을 좌우하는 항목인데 이름만으로는 무엇인지 알 수 없다 -->
                        <button class="help-dot" type="button"
                                @click.prevent.stop="showMciHelp = !showMciHelp"
                                :aria-expanded="showMciHelp" aria-label="MCI/MCG 설명">?</button>
                    </label>
                    <label class="loan-select" x-show="loanResult.productType === 'MORTGAGE'"
                           title="만기까지 고정이면 금리가 오를 위험이 없어 스트레스가 붙지 않습니다">
                        <span>금리유형</span>
                        <select x-model="loanForm.rateType" @change="runLoanEstimate()">
                            <option value="VARIABLE">변동금리</option>
                            <option value="MIXED">혼합형(고정 후 변동)</option>
                            <option value="PERIODIC">주기형</option>
                            <option value="FIXED">고정금리</option>
                        </select>
                    </label>
                    <label class="loan-select" x-show="loanResult.productType === 'MORTGAGE'"
                           title="규제지역과 함께 LTV 비율을 가릅니다">
                        <span>보유 주택</span>
                        <select x-model.number="loanForm.ownedHouseCount" @change="runLoanEstimate()">
                            <option :value="0">무주택</option>
                            <option :value="1">1주택</option>
                            <option :value="2">2주택 이상</option>
                        </select>
                    </label>
                    <span class="loan-assume-item">연소득 <b x-text="fmtWon(loanResult.usedAnnualIncome)"></b></span>
                    <span class="loan-assume-item">보유 현금 <b x-text="fmtWon(loanResult.usedCash)"></b>
                        <!-- 한도에는 내 현금만 들어간다. 그룹이 모을 수 있는 돈도 함께 본다 (설계 I114) -->
                        <small x-show="loanResult.groupCash != null && loanResult.groupCash !== loanResult.usedCash"
                               x-text="'(그룹 합산 ' + fmtWon(loanResult.groupCash) + ')'"></small>
                    </span>
                    <span class="loan-assume-item" x-show="loanResult.usedExistingLoan > 0">
                        기존 대출 <b x-text="fmtWon(loanResult.usedExistingLoan)"></b>
                        <small x-text="'(연 ' + fmtWon(loanResult.existingLoanAnnual) + ' 상환)'"></small>
                    </span>
                    <button class="btn btn-xs" type="button" @click="loanShowInputs = !loanShowInputs"
                            x-text="loanShowInputs ? '접기' : '값 바꿔보기'"></button>
                </div>

                <!-- MCI/MCG 설명 — 이름만으로는 무엇인지 알 수 없는데 한도를 5,500만원 좌우한다 -->
                <div class="loan-help" x-show="showMciHelp" x-cloak>
                    <p>
                        <b>방공제</b>부터 — 집이 경매로 넘어가면 소액 세입자가 은행보다 먼저 보증금 일부를
                        돌려받습니다(주택임대차보호법). 은행은 그 위험만큼 <b>대출에서 미리 빼둡니다.</b>
                        지역마다 다르고 서울은 5,500만원입니다.
                    </p>
                    <p>
                        <b>MCI·MCG</b>는 그 위험을 보험사·보증기관이 대신 떠안는 상품입니다.
                        가입하면 은행이 방공제를 빼지 않아 <b>한도가 그만큼 늘어납니다.</b>
                    </p>
                    <ul>
                        <li><b>MCI</b> — 서울보증보험. 보통 은행이 단체로 들어 두며 세대당 1건까지입니다.</li>
                        <li><b>MCG</b> — 한국주택금융공사. 차주가 보증료를 내고, 소득·주택가격 요건이 있습니다.</li>
                    </ul>
                    <p class="loan-help-warn">
                        전세나 월세를 낀 집은 가입이 안 되거나 제한됩니다.
                        <b>은행에서 가입 가능하다고 확인받은 경우에만</b> 체크해 주세요 —
                        아니라면 한도가 실제보다 높게 나옵니다.
                    </p>
                </div>

                <!-- 임시 조건 변경 — 프로필은 건드리지 않는다 -->
                <div class="loan-override" x-show="loanShowInputs" x-cloak>
                    <div class="form-grid">
                        <label>연소득 (원)
                            <span class="money-row">
                                <input type="text" inputmode="numeric" :value="loanOverride.annualIncome" @input="loanOverride.annualIncome = numericInput($event)" :placeholder="loanResult.usedAnnualIncome" style="width:50%">
                                <span class="money-hint" x-show="moneyHint(loanOverride.annualIncome)"
                                      x-text="moneyHint(loanOverride.annualIncome)"></span>
                            </span>
                        </label>
                        <label class="span2">보유 현금 (총 자산에서 가용 가능한 금액 - 원)
                            <input type="text" inputmode="numeric" :value="loanOverride.cash" @input="loanOverride.cash = numericInput($event)" :placeholder="loanResult.usedCash" style="width:50%">
                        </label>
                        <label>기존 대출액 (원)
                            <span class="money-row">
                                <input type="text" inputmode="numeric" :value="loanOverride.existingLoan" @input="loanOverride.existingLoan = numericInput($event)" :placeholder="loanResult.usedExistingLoan" style="width:50%">
                                <span class="money-hint" x-show="moneyHint(loanOverride.existingLoan)"
                                      x-text="moneyHint(loanOverride.existingLoan)"></span>
                            </span>
                        </label>
                    </div>
                    <p class="loan-note">이 화면에서만 쓰는 값입니다. 프로필은 바뀌지 않습니다.</p>
                    <button class="btn btn-primary btn-sm" type="button" @click="runLoanEstimate()" :disabled="loading">
                        <span x-text="loading ? '계산 중…' : '다시 계산'"></span>
                    </button>
                </div>

                <p class="loan-note">
                    <b>예상 대출한도이며 실제 금융기관 심사 결과와 다를 수 있습니다.</b>
                    <span x-show="loanResult.productType === 'MORTGAGE'">
                        담보가치는 <span x-text="loanResult.collateralSourceLabel"></span> 기준이고,
                    </span>
                    <span x-show="loanResult.productType === 'JEONSE'">
                        보증기관(HUG·HF·SGI)과 상품에 따라 보증비율·한도가 달라지며,
                    </span>
                    한도는 스트레스 금리를 더해 계산했습니다.
                </p>
            </div>
        </template>

        <template x-if="!loanResult && !loading">
            <p class="m2-empty">계산할 수 없습니다. 프로필에 연소득과 보유 현금을 입력했는지 확인해 주세요.</p>
        </template>
        <p class="form-error" x-show="error" x-text="error"></p>
    </div>
</div>

<!-- D25 매물 코멘트 모달 (설계 I56) -->
<!-- 가격 전망 상세 (설계 I136) -->
<div class="modal" x-show="showForecast" x-cloak>
    <div class="modal-backdrop" @click="closeTopModal()"></div>
    <div class="modal-card modal-wide">
        <button class="modal-close" @click="closeForecast()">×</button>
        <div class="modal-head">
            <span class="modal-kicker">가격 전망</span>
            <h3 x-text="forecastProperty ? propertyTitle(forecastProperty.property) : ''"></h3>
        </div>
        <!-- 응답이 늦으면 진행 막대를 띄운다 (설계 I115) -->
        <div class="progress-strip" x-show="isLoading('forecast')" x-cloak>
            <span class="progress-strip-label">데이터 로딩 중입니다…</span>
            <div class="progress-strip-bar"><i></i></div>
        </div>

        <template x-if="forecastDetail">
            <div>
                <div class="forecast-verdict">
                    <span class="forecast-verdict-arrow" :class="arrowClassOf(forecastDetail.direction)"
                          x-text="arrowOf(forecastDetail.direction)"></span>
                    <!-- 상승·하락만 이름을 갖는다. 그 외에는 판단 보류 (설계 I247) -->
                    <b x-text="forecastVerdictLabel(forecastDetail.direction, forecastDetail.directionLabel)"></b>
                    <!-- AI 와 지표 셈이 따로 같은 결론에 닿았다 (설계 I249) -->
                    <span class="forecast-strong" x-show="forecastDetail.strong" x-cloak
                          title="AI 판단과 지표를 센 결과가 같은 쪽입니다">(유력)</span>
                    <span class="forecast-verdict-meta" x-show="forecastDetail.confidenceLabel"
                          x-text="'확신도 ' + forecastDetail.confidenceLabel"></span>
                    <span class="forecast-verdict-meta" x-show="forecastDetail.horizonMonths"
                          x-text="'향후 ' + forecastDetail.horizonMonths + '개월'"></span>
                </div>

                <!-- 요인별 근거를 접지 않고 펼쳐 둔다. 결론만 크게 띄우면 근거를 아무도 안 본다 -->
                <template x-if="forecastDetail.factors && forecastDetail.factors.length">
                    <div class="forecast-factors">
                        <template x-for="f in forecastDetail.factors" :key="f.name">
                            <div class="forecast-factor">
                                <div class="forecast-factor-head">
                                    <span class="forecast-factor-name" x-text="f.name"></span>
                                    <span class="forecast-factor-effect" :class="arrowClassOf(f.effect)"
                                          x-text="arrowOf(f.effect)"></span>
                                    <span class="forecast-factor-weight" x-text="f.weightLabel"></span>
                                </div>
                                <p class="forecast-factor-evidence" x-text="f.evidence"></p>
                            </div>
                        </template>
                    </div>
                </template>

                <template x-if="!forecastDetail.factors || !forecastDetail.factors.length">
                    <p class="m2-empty">아직 산출된 지표가 없습니다.</p>
                </template>

                <!-- 코드 예측과 갈렸으면 문장으로 말한다 (설계 5.2). 경고가 아니라 참고다 -->
                <p class="forecast-note" x-show="forecastCompareNote()"
                   x-text="forecastCompareNote()"></p>

                <template x-if="forecastDetail.caveats && forecastDetail.caveats.length">
                    <div class="forecast-caveats">
                        <template x-for="(c, i) in forecastDetail.caveats" :key="i">
                            <p x-text="'⚠ ' + c"></p>
                        </template>
                    </div>
                </template>

                <!-- 관련 기사 (설계 I137). 점수에도 프롬프트에도 반영되지 않는다 -->
                <template x-if="forecastNews.length">
                    <div class="forecast-news">
                        <h4 class="card-title">관련 기사
                            <span class="forecast-news-warn">※ 검증하지 않은 외부 기사입니다</span>
                        </h4>
                        <template x-for="n in forecastNews" :key="n.link">
                            <a class="forecast-news-item" :href="n.link" target="_blank" rel="noopener noreferrer">
                                <span class="forecast-news-date" x-text="n.publishedOn || ''"></span>
                                <span class="forecast-news-title" x-text="n.title"></span>
                                <span class="forecast-news-source" x-text="n.source || ''"></span>
                            </a>
                        </template>
                    </div>
                </template>

                <p class="forecast-disclaimer">
                    이 전망은 예측일 뿐이며 실제 결과와 괴리가 있을 수 있습니다.
                    투자 판단의 근거로 삼지 마십시오.
                </p>
                <p class="settings-note" x-show="forecastDetail.computedAt"
                   x-text="'산출 ' + fmtTime(forecastDetail.computedAt)
                           + (forecastDetail.model ? ' · ' + forecastDetail.model : ' · 규칙 기반')"></p>
            </div>
        </template>

        <div class="score-actions">
            <button class="btn" type="button" @click="refreshForecast()"
                    :disabled="isLoading('forecastRefresh')">다시 분석</button>
            <button class="btn btn-primary" @click="closeForecast()">닫기</button>
        </div>
    </div>
</div>

<div class="modal" x-show="showComments" x-cloak>
    <div class="modal-backdrop" @click="closeTopModal()"></div>
    <div class="modal-card modal-wide">
        <button class="modal-close" @click="closeComments()">×</button>
        <div class="modal-head">
            <span class="modal-kicker">코멘트</span>
            <h3 x-text="propertyTitle(commentProperty?.property)"></h3>
            <p>이 매물에 대한 각자의 생각을 남깁니다. 한 사람당 한 건이며 언제든 고쳐 쓸 수 있습니다.</p>
        </div>
        <!-- 응답이 늦으면 진행 막대를 띄운다 (설계 I115) -->
        <div class="progress-strip" x-show="isLoading('comments')" x-cloak>
            <span class="progress-strip-label">데이터 로딩 중입니다…</span>
            <div class="progress-strip-bar"><i></i></div>
        </div>

        <div class="comment-list">
            <template x-if="comments.length === 0">
                <p class="m2-empty">아직 남긴 코멘트가 없습니다.</p>
            </template>
            <template x-for="c in comments" :key="c.id">
                <article class="comment" :class="{ mine: c.mine }">
                    <div class="comment-head">
                        <span class="comment-who" x-text="c.nickname"></span>
                        <span class="badge b-mem" x-show="c.mine">나</span>
                        <time class="comment-time" x-text="fmtTime(c.updatedAt || c.createdAt)"></time>
                        <span class="comment-edited" x-show="c.updatedAt">수정됨</span>
                        <div class="comment-actions" x-show="c.mine && commentEditingId !== c.id">
                            <button class="btn btn-xs" @click="startEditComment(c)">수정</button>
                            <button class="btn btn-xs btn-danger" @click="removeComment(c)">삭제</button>
                        </div>
                    </div>
                    <p class="comment-body" x-show="commentEditingId !== c.id" x-text="c.content"></p>
                    <div class="comment-edit" x-show="commentEditingId === c.id" x-cloak>
                        <textarea rows="4" x-model="commentEditText" maxlength="2000"></textarea>
                        <div class="comment-edit-actions">
                            <button class="btn btn-sm" @click="cancelEditComment()">취소</button>
                            <button class="btn btn-primary btn-sm" @click="saveEditComment(c)" :disabled="loading">저장</button>
                        </div>
                    </div>
                </article>
            </template>
        </div>

        <!-- 아직 안 남겼을 때만 입력칸을 연다 -->
        <div class="comment-new" x-show="!myComment" x-cloak>
            <label for="commentNew">내 코멘트</label>
            <!-- 애플펜슬(Scribble)로 쓰는 것을 염두에 둔다 (설계 I236).
                 별도 구현은 필요 없다 — 표준 textarea 면 iPadOS 가 알아서 받는다.
                 대신 <b>손으로 쓸 자리</b>가 있어야 하고(.comment-input),
                 쓰다 만 글은 담아 둔다(@input) -->
            <textarea id="commentNew" class="comment-input" rows="4"
                      x-model="commentNewText" maxlength="2000"
                      @input.debounce.500ms="saveCommentDraft()"
                      autocapitalize="sentences" enterkeyhint="enter" spellcheck="false"
                      placeholder="직접 보고 느낀 점, 걸리는 점을 남겨 주세요"></textarea>
            <div class="comment-edit-actions">
                <span class="comment-count" x-text="commentNewText.length + ' / 2000'"></span>
                <button class="btn btn-primary btn-sm" @click="addComment()"
                        :disabled="loading || !commentNewText.trim()">남기기</button>
            </div>
        </div>
        <p class="form-error" x-show="error" x-text="error"></p>
    </div>
</div>

<!-- D26 비교 우위 분석 모달 (설계 I61) -->
<div class="modal" x-show="showCompare" x-cloak>
    <div class="modal-backdrop" @click="closeTopModal()"></div>
    <div class="modal-card modal-xwide">
        <button class="modal-close" @click="closeCompare()">×</button>
        <div class="modal-head">
            <span class="modal-kicker">비교 우위</span>
            <h3>매물 비교 분석</h3>
            <p>등록된 매물 전체를 한 번에 견주어 순위를 매깁니다. 판매완료·작성 중 매물은 제외됩니다.</p>
        </div>

        <div class="compare-bar">
            <span class="compare-count">
                비교 대상 <b x-text="compareStatus ? compareStatus.propertyCount : 0"></b>건
                <small x-text="'(최소 ' + (compareStatus ? compareStatus.minProperties : 4) + '건 필요)'"></small>
            </span>
            <button class="btn btn-primary btn-sm" @click="runCompare()"
                    :disabled="compareRunning || !canCompare()">
                <span x-text="compareRunning ? '분석 중…' : (hasCompareResult() ? '다시 분석' : '분석 실행')"></span>
            </button>
        </div>

        <p class="compare-warn" x-show="!canCompare()" x-text="compareHint()"></p>
        <p class="form-error" x-show="compareError" x-text="compareError"></p>

        <template x-if="hasCompareResult()">
            <div class="compare-list">
                <template x-for="r in compareStatus.rankings" :key="r.propertyId">
                    <article class="compare-row" :class="{ top: r.rank === 1 }">
                        <div class="compare-rank">
                            <b x-text="r.rank"></b><i x-text="'/ ' + r.propertyCount"></i>
                        </div>
                        <div class="compare-body">
                            <div class="compare-title">
                                <span class="compare-name" x-text="r.propertyName"></span>
                                <span class="score-pill" :class="r.score >= 50 ? 'score-high' : 'score-low'">
                                    <b x-text="fmtScore(r.score)"></b><i>점</i>
                                </span>
                            </div>
                            <p class="compare-reason" x-text="r.reason"></p>
                        </div>
                    </article>
                </template>
                <p class="compare-meta">
                    <span x-text="compareStatus.rankings[0].model"></span>
                    <span x-text="fmtTime(compareStatus.rankings[0].computedAt)"></span>
                </p>
            </div>
        </template>
        <template x-if="!hasCompareResult() && compareRunning">
            <div class="progress-strip">
                <span class="progress-strip-label">AI가 데이터를 분석 중입니다…</span>
                <div class="progress-strip-bar"><i></i></div>
            </div>
        </template>
        <template x-if="!hasCompareResult() && !compareRunning">
            <p class="m2-empty">아직 분석 결과가 없습니다.</p>
        </template>
    </div>
</div>

<!-- D21 판매완료 알림 확인 모달 -->
<div class="modal" x-show="showSoldOutAlert" x-cloak>
    <div class="modal-backdrop" @click="closeTopModal()"></div>
    <div class="modal-card">
        <div class="modal-head">
            <span class="modal-kicker">알림</span>
            <h3>판매완료 감지 매물</h3>
            <p>생존 확인 배치에서 판매완료로 판정된 매물입니다.</p>
        </div>
        <div class="property-list">
            <template x-for="p in soldOutRecent" :key="p.id">
                <article class="property-card sold">
                    <div class="property-card-header">
                        <span class="property-card-name" x-text="propertyTitle(p)"></span>
                        <span class="property-card-price" x-text="fmtWon(p.priceDeposit)"></span>
                    </div>
                    <div class="property-card-meta">
                        <span class="badge b-off">판매완료</span>
                        <span x-text="p.soldDetectedAt ? '감지 ' + fmtTime(p.soldDetectedAt) : ''"></span>
                    </div>
                </article>
            </template>
        </div>
        <div class="paste-actions">
            <button class="btn btn-primary" @click="closeSoldOutAlert()">확인</button>
        </div>
    </div>
</div>

<!-- 경로를 아예 못 낸 경우 (설계 I274).
     구간 하나도 못 받았으면 순서도 뜻이 없다 — 결과를 보여 주는 대신 말한다 -->
<div class="modal" x-show="showItinUnavailable" x-cloak>
    <div class="modal-backdrop" @click="closeItinUnavailable()"></div>
    <div class="modal-card">
        <div class="modal-head">
            <span class="modal-kicker">알림</span>
            <h3>최적 경로를 산출하지 못했습니다</h3>
        </div>
        <!-- 문구는 <b>서버가 준 것</b>을 그대로 (설계 I274). 화면에 또 적으면 두 벌이 된다 -->
        <p class="itin-unavailable" x-text="itinUnavailableMessage"></p>
        <div class="paste-actions">
            <button class="btn btn-primary" @click="closeItinUnavailable()">확인</button>
        </div>
    </div>
</div>

<!-- D23 로드뷰 모달 -->
<div class="modal modal-roadview" x-show="showRoadview" x-cloak>
    <div id="roadview" class="rv-canvas"></div>
    <div class="rv-fallback" x-show="roadviewState === 'missing'">
        <div class="empty-ic">◌</div>
        <h4>이 위치는 로드뷰가 제공되지 않습니다</h4>
        <p>신축 단지나 골목 안쪽은 로드뷰가 없을 수 있습니다.</p>
    </div>
    <div class="rv-top" x-show="roadviewProperty">
        <div class="rv-info">
            <span class="rv-name" x-text="propertyTitle(roadviewProperty)"></span>
            <span class="rv-meta">
                <span class="badge" :class="roadviewProperty ? dealBadge(roadviewProperty.dealType) : ''" x-text="roadviewProperty ? dealLabel(roadviewProperty.dealType) : ''"></span>
                <span x-text="roadviewProperty ? fmtWon(roadviewProperty.priceDeposit) : ''"></span>
            </span>
        </div>
        <button class="btn btn-ghost" @click="closeRoadview()">닫기</button>
    </div>
</div>

</body>
</html>
